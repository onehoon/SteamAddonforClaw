<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Steam Input Addon for Claw">
    <NavigationView
        x:Name="MainNavigationView"
        PaneDisplayMode="Left"
        Loaded="MainNavigationView_Loaded"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="StatusNavigationItem"
                Content="Status"
                Tag="Status">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="How to Use" Tag="HowToUse">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <StackPanel
                x:Name="StatusContent"
                Padding="32"
                Spacing="12">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Steam Input Addon for Claw" />
                <TextBlock x:Name="VersionText" />
                <TextBlock FontWeight="SemiBold" Text="Status" />
                <TextBlock x:Name="StatusText" Text="Steam inactive" />
                <TextBlock x:Name="RunningAppIdText" Text="RunningAppID: 0" />
                <TextBlock x:Name="ExternalControllerText" Text="External controller: Indeterminate" />
            </StackPanel>

            <StackPanel
                x:Name="HowToUseContent"
                Padding="32"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="How to Use" />
            </StackPanel>

            <StackPanel
                x:Name="SettingsContent"
                Padding="32"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />
                <CheckBox
                    x:Name="LaunchAtWindowsStartupCheckBox"
                    Click="LaunchAtWindowsStartupCheckBox_Click"
                    Content="Launch at Windows startup" />
                <TextBlock x:Name="StartupSettingsStatusText" TextWrapping="Wrap" />
                <Rectangle Height="1" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" Margin="0,16,0,4" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Developer Diagnostics" />
                <TextBlock FontWeight="SemiBold" Text="M1/M2 DirectInput Test" />
                <TextBlock Text="Tests the existing PID_1902 DirectInput device only. No controller mode changes are made." TextWrapping="Wrap" />
                <TextBlock x:Name="M1M2TestStatusText" Text="Status: Idle" />
                <TextBlock x:Name="M1TestStatusText" Text="M1: Waiting" />
                <TextBlock x:Name="M2TestStatusText" Text="M2: Waiting" />
                <TextBlock x:Name="IndependentTestStatusText" Text="Independent: Waiting" />
                <Button x:Name="StartM1M2TestButton" Click="StartM1M2TestButton_Click" Content="Start M1/M2 Test" />
                <Button x:Name="StopM1M2TestButton" Click="StopM1M2TestButton_Click" Content="Stop Test" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
