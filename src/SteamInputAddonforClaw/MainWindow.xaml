<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Steam Input Addon for Claw">
    <StackPanel Padding="32" Spacing="12">
        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Steam Input Addon for Claw" />
        <TextBlock x:Name="VersionText" />
        <TextBlock FontWeight="SemiBold" Text="Status" />
        <TextBlock x:Name="StatusText" Text="Steam inactive" />
        <TextBlock x:Name="RunningAppIdText" Text="RunningAppID: 0" />
        <TextBlock x:Name="ExternalControllerText" Text="External controller: Indeterminate" />
    </StackPanel>
</Window>
