<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Steam Input Addon for Claw">
    <NavigationView
        x:Name="MainNavigationView"
        PaneDisplayMode="Left"
        Loaded="MainNavigationView_Loaded"
        PointerPressed="MainNavigationView_PointerPressed"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="StatusNavigationItem"
                Content="Status"
                Tag="Status">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="How to Use" Tag="HowToUse">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <ScrollViewer x:Name="StatusContent" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock FontSize="24" FontWeight="SemiBold" Text="Status" /><TextBlock x:Name="VersionText" Opacity="0.7" /></StackPanel>
                        <Button x:Name="RefreshStatusButton" Grid.Column="1" Click="RefreshStatusButton_Click" Content="↻ Refresh" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Device Information" />
                    <Border Padding="18,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="4"><TextBlock x:Name="DeviceManufacturerText" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="DeviceModelText" FontSize="18" /><TextBlock x:Name="DeviceGpuText" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Controller Software" />
                    <ListView x:Name="ControllerSoftwareList" IsItemClickEnabled="False" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Routing Components" />
                    <ListView x:Name="RoutingComponentsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="External Controllers" />
                    <ListView x:Name="ExternalControllersList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Runtime" />
                    <ListView x:Name="RuntimeStatusList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="HowToUseContent"
                Padding="32"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="How to Use" />
            </StackPanel>

            <StackPanel
                x:Name="SettingsContent"
                Padding="32"
                Spacing="16"
                Visibility="Collapsed">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />

                <Border
                    Padding="18,16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Play" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Launch at Windows startup" />
                            <TextBlock Opacity="0.7" Text="Start the addon three minutes after you sign in to Windows." TextWrapping="Wrap" />
                            <TextBlock x:Name="StartupSettingsStatusText" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LaunchAtWindowsStartupToggleSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="LaunchAtWindowsStartupToggleSwitch_Toggled"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button
                    Click="DeveloperMenuButton_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="18,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Help" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Developer Menu" />
                            <TextBlock Opacity="0.7" Text="Developer-only diagnostics. General users should not use this menu." TextWrapping="Wrap" />
                        </StackPanel>
                        <SymbolIcon Grid.Column="2" Opacity="0.7" Symbol="Forward" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="DeveloperMenuContent"
                Padding="32"
                Spacing="12"
                Visibility="Collapsed">
                <Button
                    Click="DeveloperMenuBackButton_Click"
                    Content="Back to Settings"
                    HorizontalAlignment="Left" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Developer Menu" />
                <TextBlock
                    Opacity="0.7"
                    Text="These diagnostics are for developers only. General users should not use this menu."
                    TextWrapping="Wrap" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="M1/M2 DirectInput Test" />
                <TextBlock Text="Tests the existing PID_1902 DirectInput device only. No controller mode changes are made." TextWrapping="Wrap" />
                <TextBlock x:Name="M1M2TestStatusText" Text="Status: Idle" />
                <TextBlock x:Name="M1TestStatusText" Text="M1: Waiting" />
                <TextBlock x:Name="M2TestStatusText" Text="M2: Waiting" />
                <TextBlock x:Name="IndependentTestStatusText" Text="Independent: Waiting" />
                <Button x:Name="StartM1M2TestButton" Click="StartM1M2TestButton_Click" Content="Start M1/M2 Test" />
                <Button x:Name="StopM1M2TestButton" Click="StopM1M2TestButton_Click" Content="Stop Test" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
