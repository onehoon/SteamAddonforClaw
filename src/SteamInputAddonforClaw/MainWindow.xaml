<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Steam Input Addon for Claw">
    <NavigationView
        x:Name="MainNavigationView"
        PaneDisplayMode="Left"
        Loaded="MainNavigationView_Loaded"
        PointerPressed="MainNavigationView_PointerPressed"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="StatusNavigationItem"
                Content="Status"
                Tag="Status">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="How to Use" Tag="HowToUse">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <ScrollViewer x:Name="StatusContent" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Status" />
                        <Button x:Name="RefreshStatusButton" Grid.Column="1" Click="RefreshStatusButton_Click" Content="↻ Refresh" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Device Information" />
                    <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="DeviceManufacturerText" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="DeviceModelText" FontSize="20" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="DeviceSupportText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid><TextBlock x:Name="DeviceBoardGpuText" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Controller Software" />
                    <ItemsRepeater x:Name="ControllerSoftwareRepeater"><ItemsRepeater.Layout><UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3" MinItemWidth="240" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" /></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate><Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center"/><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Routing Components" />
                    <ItemsRepeater x:Name="RoutingComponentsRepeater"><ItemsRepeater.Layout><UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3" MinItemWidth="240" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" /></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate><Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center"/><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="External Controllers" />
                    <ListView x:Name="ExternalControllersList" SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                    <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="Runtime" />
                    <ListView x:Name="RuntimeStatusList" SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="8,3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SetupContent" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Set up Steam Input Addon for Claw" />
                    <TextBlock Opacity="0.7" Text="Your system needs a few components before Steam controller routing can be enabled." TextWrapping="Wrap" />
                    <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Required components" />
                            <TextBlock x:Name="SetupHidHideText" />
                            <TextBlock x:Name="SetupUsbIpText" />
                            <TextBlock Text="VIIPER runtime is not included in this build." Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="USB devices may briefly disconnect while the required controller driver is installed. Save work using USB storage or USB audio devices before continuing." Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="SetupStatusText" Opacity="0.7" TextWrapping="Wrap" />
                    <Button x:Name="InstallRequiredComponentsButton" HorizontalAlignment="Left" Click="InstallHidHideButton_Click" Content="Install Required Components" />
                    <Button HorizontalAlignment="Left" Click="ShowStatusButton_Click" Content="View Status" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="HowToUseContent"
                Padding="32"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="How to Use" />
            </StackPanel>

            <ScrollViewer
                x:Name="SettingsContent"
                Padding="32"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />

                <Border
                    Padding="18,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Play" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Launch at Windows startup" />
                            <TextBlock x:Name="StartupSettingsStatusText" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LaunchAtWindowsStartupToggleSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="LaunchAtWindowsStartupToggleSwitch_Toggled"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button
                    Click="DeveloperMenuButton_Click"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="18,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Help" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Developer Menu" />
                            <TextBlock Opacity="0.7" Text="Developer-only diagnostics. General users should not use this menu." TextWrapping="Wrap" />
                        </StackPanel>
                        <SymbolIcon Grid.Column="2" Opacity="0.7" Symbol="Forward" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="DeveloperMenuContent"
                Padding="32"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                <Button
                    Click="DeveloperMenuBackButton_Click"
                    Content="Back to Settings"
                    HorizontalAlignment="Left" />
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Developer Menu" />
                <TextBlock
                    Opacity="0.7"
                    Text="These diagnostics are for developers only. General users should not use this menu."
                    TextWrapping="Wrap" />
                <Border Padding="18,16" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Repair" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Test Mode" />
                            <TextBlock Opacity="0.7" Text="Treat Steam session as active without launching a game. This setting is not saved and resets when the app restarts." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TestModeToggleSwitch" Grid.Column="2" Width="48" HorizontalAlignment="Right" OffContent="" OnContent="" Toggled="TestModeToggleSwitch_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Environment Discovery" />
                        <TextBlock Opacity="0.7" Text="Generate a read-only system report for controller software detection development." TextWrapping="Wrap" />
                        <Button x:Name="GenerateEnvironmentDiscoveryReportButton" Click="GenerateEnvironmentDiscoveryReportButton_Click" Content="Generate Report" HorizontalAlignment="Left" />
                        <TextBlock x:Name="EnvironmentDiscoveryReportStatusText" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="OpenEnvironmentDiscoveryFolderButton" Click="OpenEnvironmentDiscoveryFolderButton_Click" Content="Open Folder" HorizontalAlignment="Left" IsEnabled="False" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
