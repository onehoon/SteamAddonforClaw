<UserControl
    x:Class="SteamInputAddonforClaw.Views.ClawSensorProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="14">
            <Button Click="BackButton_Click" Content="Back to Developer Menu" HorizontalAlignment="Left" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Claw Sensor Probe" />
            <TextBlock Opacity="0.7" Text="Read-only motion sensor diagnostic. This probe does not modify controller routing." TextWrapping="Wrap" />
            <TextBlock x:Name="ClawSensorProbeDeviceText" Text="Device: MSI Claw" />
            <TextBlock x:Name="ClawSensorProbeModelText" Text="Model: Unknown / unresolved" />
            <TextBlock x:Name="ClawSensorProbeBoardText" Text="Base board: Unavailable" />
            <TextBlock x:Name="ClawSensorProbeGyroText" Text="Gyroscope: Not discovered" />
            <TextBlock x:Name="ClawSensorProbeAccelText" Text="Accelerometer: Not discovered" />
            <Button x:Name="ClawSensorProbeStartButton" Content="Start Test" Click="ClawSensorProbeStartButton_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ClawSensorProbeStatusText" Text="Ready" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ClawSensorProbePhaseText" Text="Step: Not started" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ClawSensorProbeInstructionText" Text="Keep Still: Place the device on a flat surface and do not touch it." TextWrapping="Wrap" />
            <TextBlock x:Name="ClawSensorProbeLiveText" Text="Gyroscope: waiting&#x0a;Accelerometer: waiting" TextWrapping="Wrap" FontFamily="Consolas" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ClawSensorProbeBackPhaseButton" Content="Back" Click="ClawSensorProbeBackPhaseButton_Click" IsEnabled="False" />
                <Button x:Name="ClawSensorProbeNextPhaseButton" Content="Next" Click="ClawSensorProbeNextPhaseButton_Click" IsEnabled="False" />
                <Button x:Name="ClawSensorProbeStopButton" Content="Stop Test" Click="ClawSensorProbeStopButton_Click" IsEnabled="False" />
            </StackPanel>
            <Button x:Name="ClawSensorProbeOpenFolderButton" Content="Open Log Folder" Click="ClawSensorProbeOpenFolderButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <Button x:Name="ClawSensorProbeDoneButton" Content="Done" Click="ClawSensorProbeDoneButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
            <TextBlock x:Name="ClawSensorProbeSummaryText" TextWrapping="Wrap" />
            <TextBlock x:Name="ClawSensorProbeErrorText" TextWrapping="Wrap" Foreground="OrangeRed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
