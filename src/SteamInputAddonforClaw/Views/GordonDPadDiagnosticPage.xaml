<UserControl
    x:Class="SteamInputAddonforClaw.Views.GordonDPadDiagnosticPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        Padding="32"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button
                Click="BackButton_Click"
                Content="Back to Developer Menu"
                HorizontalAlignment="Left" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Gordon D-pad Diagnostic" />
            <TextBlock
                Opacity="0.7"
                Text="Read-only end-to-end Gordon input diagnostics. This never changes controller mapping, routing, or virtual-device behavior."
                TextWrapping="Wrap" />

            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Status" />
                    <TextBlock x:Name="GordonStatusText" Text="Gordon: Not Available" />
                    <TextBlock x:Name="NativeTraceStatusText" Text="Native Trace: Not Available" />
                    <TextBlock x:Name="WindowsHidStatusText" Text="Windows HID: Not Available" />
                    <TextBlock x:Name="CaptureStatusText" Text="Capture: Stopped" />
                    <TextBlock x:Name="MessageText" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Last D-pad transition" />
                    <TextBlock x:Name="LastPhysicalText" Text="Physical: (none observed yet)" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastCanonicalText" Text="Canonical: (none observed yet)" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastAbiDecodedText" Text="ABI Decoded: (none observed yet)" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastGordonReportText" Text="Gordon Report: (none observed yet)" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastWindowsHidText" Text="Windows HID: (none observed yet)" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartCaptureButton" Click="StartCaptureButton_Click" Content="Start Capture" />
                <Button x:Name="StopCaptureButton" Click="StopCaptureButton_Click" Content="Stop Capture" IsEnabled="False" />
                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Content="Open Diagnostic Folder" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
