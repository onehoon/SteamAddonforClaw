<UserControl
    x:Class="SteamInputAddonforClaw.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20,16">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Status" />
                <Button x:Name="RefreshStatusButton" Grid.Column="1" Click="RefreshStatusButton_Click" Content="↻ Refresh" VerticalAlignment="Center" />
            </Grid>

            <!-- Overall status hero -->
            <Border Padding="20,18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <SymbolIcon x:Name="HeroIcon" Symbol="Sync" VerticalAlignment="Top" />
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="HeroTitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="HeroReasonText" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusInfoBar" IsClosable="False" IsOpen="False" />

            <!-- Summary tiles -->
            <ItemsRepeater x:Name="SummaryTilesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill" MaximumRowsOrColumns="3" MinColumnSpacing="8" MinItemWidth="220" MinRowSpacing="8" Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock Opacity="0.7" Text="{Binding Header}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="Controller Software" />
            <Border Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ItemsRepeater x:Name="ControllerSoftwareRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Padding="16,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="8,3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}" /></Border>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="Routing Components" />
            <Border Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ItemsRepeater x:Name="RoutingComponentsRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Padding="16,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="8,3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}" /></Border>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="Runtime" />
            <Border Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ItemsRepeater x:Name="RuntimeStatusRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Padding="16,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2"><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Opacity="0.7" Text="{Binding Secondary}" TextWrapping="Wrap" /></StackPanel>
                                    <Border Grid.Column="1" Padding="8,3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="12" VerticalAlignment="Top"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Status}" /></Border>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
