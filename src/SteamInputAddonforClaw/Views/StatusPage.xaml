<UserControl
    x:Class="SteamInputAddonforClaw.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="20,16">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Status" />
                <Button x:Name="RefreshStatusButton" Grid.Column="1" Click="RefreshStatusButton_Click" Content="↻ Refresh" VerticalAlignment="Center" />
            </Grid>

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Device" />
            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DeviceManufacturerText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceModelText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceSupportText" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DeviceBoardGpuText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="Current Status" />
            <Border Padding="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Steam Game" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SteamGameStatusText" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" />
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Controller Status" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ControllerStatusText" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusInfoBar" IsClosable="False" IsOpen="False" />

            <ctcontrols:SettingsExpander x:Name="ControllerSoftwareExpander" Header="Controller Software" />

            <ctcontrols:SettingsExpander x:Name="RoutingComponentsExpander" Header="Routing Components" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
