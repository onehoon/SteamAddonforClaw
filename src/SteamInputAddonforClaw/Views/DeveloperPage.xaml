<UserControl
    x:Class="SteamInputAddonforClaw.Views.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer
        Padding="32"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button
                Click="BackButton_Click"
                Content="Back to Settings"
                HorizontalAlignment="Left" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Developer Menu" />
            <TextBlock
                Opacity="0.7"
                Text="These diagnostics are for developers only. General users should not use this menu."
                TextWrapping="Wrap" />

            <ctcontrols:SettingsCard Header="Test Mode" Description="Treat Steam session as active without launching a game. This setting is not saved and resets when the app restarts.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="TestModeToggleSwitch" OffContent="" OnContent="" Toggled="TestModeToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>

            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Top" Symbol="Document" />
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Environment Discovery" />
                        <TextBlock Opacity="0.7" Text="Generate a read-only system report for controller software detection development." TextWrapping="Wrap" />
                        <Button x:Name="GenerateEnvironmentDiscoveryReportButton" Click="GenerateEnvironmentDiscoveryReportButton_Click" Content="Generate Report" HorizontalAlignment="Left" />
                        <TextBlock x:Name="EnvironmentDiscoveryReportStatusText" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="OpenEnvironmentDiscoveryFolderButton" Click="OpenEnvironmentDiscoveryFolderButton_Click" Content="Open Folder" HorizontalAlignment="Left" IsEnabled="False" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <ctcontrols:SettingsCard Header="Logging" Description="Control application log verbosity. Info is recommended for normal use. Debug records detailed controller and PnP diagnostics and may significantly increase log size.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Document" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LogLevelComboBox" Width="120" SelectionChanged="LogLevelComboBox_SelectionChanged">
                    <ComboBoxItem Content="Info" />
                    <ComboBoxItem Content="Debug" />
                </ComboBox>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard
                Click="ClawSensorProbeButton_Click"
                Description="Read-only gyro and accelerometer diagnostics for MSI Claw hardware research."
                Header="Claw Sensor Probe"
                IsClickEnabled="True">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Document" />
                </ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
