<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SteamInputAddonforClaw</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RootNamespace>SteamInputAddonforClaw</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!--
    dotnet publish for an unpackaged WinUI 3 app omits the XAML binary files
    and the app PRI that dotnet build produces in $(OutDir). Application.Start
    then fails while loading App.xaml/MainWindow.xaml. Preserve those generated
    runtime assets in the Velopack publish payload.
  -->
  <Target Name="CopyMissingWinUIPublishAssets" AfterTargets="Publish">
    <ItemGroup>
      <_MissingXbf Include="$(OutDir)**\*.xbf" />
      <_MissingPri Include="$(OutDir)*.pri" />
      <_MissingAssets Include="$(OutDir)Assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MissingXbf)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MissingPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MissingAssets)" DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
