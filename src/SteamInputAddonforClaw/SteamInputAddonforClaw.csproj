<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SteamInputAddonforClaw</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RootNamespace>SteamInputAddonforClaw</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamInputAddonforClaw.Contracts\SteamInputAddonforClaw.Contracts.csproj" />
    <ProjectReference Include="..\SteamInputAddonforClaw.FrontendTransport\SteamInputAddonforClaw.FrontendTransport.csproj" />
    <!-- Privileged MSI Center M startup Enable/Disable helper (work order PR1): not linked, built and
         copied alongside this app's output so CenterMStartupHelperClient can spawn it with runas. -->
    <ProjectReference Include="..\SteamInputAddonforClaw.CenterMStartupHelper\SteamInputAddonforClaw.CenterMStartupHelper.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="PublishTdpHelper" BeforeTargets="CopyTdpHelperOutput">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SteamInputAddonforClaw.TdpHelper\SteamInputAddonforClaw.TdpHelper.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;PublishDir=$(MSBuildThisFileDirectory)..\SteamInputAddonforClaw.TdpHelper\bin\$(Configuration)\net10.0\win-x64\publish\" />
  </Target>

  <Target Name="CopyTdpHelperOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <TdpHelperOutput Include="..\SteamInputAddonforClaw.TdpHelper\bin\$(Configuration)\net10.0\win-x64\publish\SteamInputAddonforClaw.TdpHelper.exe" />
    </ItemGroup>
    <Error Text="TDP helper publish output not found." Condition="!Exists('%(TdpHelperOutput.Identity)')" />
    <Copy SourceFiles="@(TdpHelperOutput)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(TdpHelperOutput)" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>

  <Target Name="PublishCenterMStartupHelper" BeforeTargets="CopyCenterMStartupHelperOutput">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SteamInputAddonforClaw.CenterMStartupHelper\SteamInputAddonforClaw.CenterMStartupHelper.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;PublishDir=$(MSBuildThisFileDirectory)..\SteamInputAddonforClaw.CenterMStartupHelper\bin\$(Configuration)\net10.0\win-x64\publish\" />
  </Target>

  <Target Name="CopyCenterMStartupHelperOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <CenterMStartupHelperOutput Include="..\SteamInputAddonforClaw.CenterMStartupHelper\bin\$(Configuration)\net10.0\win-x64\publish\SteamInputAddonforClaw.CenterMStartupHelper.exe" />
    </ItemGroup>
    <Error Text="MSI Center M startup helper publish output not found." Condition="!Exists('%(CenterMStartupHelperOutput.Identity)')" />
    <Copy SourceFiles="@(CenterMStartupHelperOutput)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(CenterMStartupHelperOutput)" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Dependencies\HidHide\HidHide_1.5.230_x64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Dependencies\UsbIpWin2\USBip-0.9.7.7-x64.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Dependencies\Viiper\libVIIPER.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Dependencies\Viiper\PROVENANCE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Dependencies\Viiper\libVIIPER.h">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Dependencies\Viiper\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
