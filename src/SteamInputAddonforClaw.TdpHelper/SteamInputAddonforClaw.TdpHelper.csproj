    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>false</SelfContained><PublishSingleFile>true</PublishSingleFile><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SteamInputAddonforClaw.TdpHelper</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><NoWarn>$(NoWarn);CA1416</NoWarn>
