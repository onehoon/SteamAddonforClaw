<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Narrow privileged helper for MSI Center M startup Enable/Disable (work order PR1, Addendum A).
         Its only job: toggle the two MSI Center M Scheduled Tasks' enabled state and set the
         MSI Foundation Service startup type. No process monitoring, no termination, no
         controller-suppression, no decoy behaviour. Mirrors the SteamInputAddonforClaw.TdpHelper
         packaging pattern (requireAdministrator manifest, short-lived, one named-pipe request). -->
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>false</SelfContained><PublishSingleFile>true</PublishSingleFile><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SteamInputAddonforClaw.CenterMStartupHelper</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" /></ItemGroup>
</Project>
