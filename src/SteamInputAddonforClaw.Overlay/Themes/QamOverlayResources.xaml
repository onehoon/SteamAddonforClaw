<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <SolidColorBrush x:Key="QamSurfaceBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamRailBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamContentBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamPrimaryTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="QamSecondaryTextBrush" Color="#FFDCDEDF" />
    <SolidColorBrush x:Key="QamDisabledTextBrush" Color="#FF969696" />
    <SolidColorBrush x:Key="QamErrorTextBrush" Color="#FF969696" />
    <SolidColorBrush x:Key="QamAccentBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamSteamBlueBrush" Color="#FF1A9FFF" />
    <SolidColorBrush x:Key="QamSelectedFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamHoverFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamPressedFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamFocusBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamSeparatorBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamSectionBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamTileBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamTileSelectedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamRailIconBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamRailIconSelectedBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamRailSelectedFillBrush" Color="#FF23262E" />
    <!-- Provisional control colors: the current Steam QAM target was unavailable for live computed-style capture. -->
    <SolidColorBrush x:Key="QamSliderTrackBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="QamSliderValueTrackBrush" Color="#88FFFFFF" />
    <SolidColorBrush x:Key="QamSliderThumbBrush" Color="#FFEEEEEE" />
    <StaticResource x:Key="QamSliderDisabledTrackBrush" ResourceKey="QamSliderTrackBrush" />
    <StaticResource x:Key="QamSliderDisabledThumbBrush" ResourceKey="QamDisabledTextBrush" />
    <StaticResource x:Key="QamToggleOffBrush" ResourceKey="QamSliderTrackBrush" />
    <StaticResource x:Key="QamToggleOnBrush" ResourceKey="QamSteamBlueBrush" />
    <StaticResource x:Key="QamToggleDisabledBrush" ResourceKey="QamDisabledTextBrush" />
    <StaticResource x:Key="QamToggleThumbBrush" ResourceKey="QamSliderThumbBrush" />
    <StaticResource x:Key="QamToggleThumbDisabledBrush" ResourceKey="QamDisabledTextBrush" />
    <StaticResource x:Key="QamValueButtonForeground" ResourceKey="QamSecondaryTextBrush" />
    <StaticResource x:Key="QamValueButtonDisabledForeground" ResourceKey="QamDisabledTextBrush" />
    <StaticResource x:Key="QamValueButtonHoverFill" ResourceKey="QamHoverFillBrush" />
    <StaticResource x:Key="QamValueButtonPressedFill" ResourceKey="QamPressedFillBrush" />

    <Thickness x:Key="QamPageTitleMargin">16,16,16,8</Thickness>
    <Thickness x:Key="QamBodyContentPadding">16,0,16,12</Thickness>
    <x:Double x:Key="QamSectionSpacing">24</x:Double>
    <Thickness x:Key="QamSectionPadding">0</Thickness>
    <CornerRadius x:Key="QamSectionCornerRadius">0</CornerRadius>
    <x:Double x:Key="QamSectionHeaderSpacing">4</x:Double>
    <Thickness x:Key="QamDetailIndent">16,0,0,0</Thickness>
    <Thickness x:Key="QamDetailMargin">16,0,16,0</Thickness>
    <x:Double x:Key="QamRowSpacing">0</x:Double>
    <Thickness x:Key="QamRowPadding">16,10,16,10</Thickness>
    <Thickness x:Key="QamRowMargin">-16,0,-16,0</Thickness>
    <x:Double x:Key="QamRowMinHeight">42</x:Double>
    <CornerRadius x:Key="QamRowCornerRadius">2</CornerRadius>
    <Thickness x:Key="QamSelectionBorderThickness">0</Thickness>
    <x:Double x:Key="QamRailButtonSize">52</x:Double>
    <x:Double x:Key="QamRailItemHeight">64</x:Double>
    <x:Double x:Key="QamRailIconSize">24</x:Double>
    <x:Double x:Key="QamRailSpacing">0</x:Double>
    <CornerRadius x:Key="QamRailCornerRadius">0</CornerRadius>
    <Thickness x:Key="QamTilePadding">12</Thickness>
    <CornerRadius x:Key="QamTileCornerRadius">2</CornerRadius>
    <x:Double x:Key="QamTileMinHeight">58</x:Double>
    <x:Double x:Key="QamTileSpacing">8</x:Double>
    <x:Double x:Key="QamDisabledOpacity">0.48</x:Double>
    <x:Double x:Key="QamSliderTrackHeight">4</x:Double>
    <x:Double x:Key="QamSliderThumbWidth">12</x:Double>
    <x:Double x:Key="QamSliderThumbHeight">12</x:Double>
    <CornerRadius x:Key="QamSliderThumbCornerRadius">6</CornerRadius>
    <x:Double x:Key="QamSliderHeight">22</x:Double>
    <x:Double x:Key="QamValueButtonWidth">40</x:Double>
    <x:Double x:Key="QamValueButtonHeight">22</x:Double>
    <x:Double x:Key="QamToggleMinHeight">22</x:Double>
    <x:Double x:Key="QamTogglePreContentMargin">1</x:Double>
    <x:Double x:Key="QamTogglePostContentMargin">1</x:Double>
    <CornerRadius x:Key="QamValueButtonCornerRadius">6</CornerRadius>
    <x:Double x:Key="QamDiscreteValueMinWidth">88</x:Double>
    <FontFamily x:Key="QamFontFamily">Segoe UI Variable</FontFamily>

    <Style x:Key="QamBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource QamSecondaryTextBrush}" />
    </Style>
    <Style x:Key="QamBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource QamPrimaryTextBrush}" />
    </Style>
    <Style x:Key="QamCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource QamDisabledTextBrush}" />
    </Style>
    <Style x:Key="QamSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource QamPrimaryTextBrush}" />
    </Style>
    <Style x:Key="QamValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyTextStyle}" />
    <Style x:Key="QamTileTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyStrongTextStyle}" />
    <Style x:Key="QamPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamSectionHeaderTextStyle}" />

    <Style x:Key="QamFlatButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource QamRowCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource QamSelectionBorderThickness}" />
        <Setter Property="BorderBrush" Value="{StaticResource QamFocusBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource QamSectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource QamPrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="FlatButtonBackground.Background" Value="{StaticResource QamHoverFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="FlatButtonBackground.Background" Value="{StaticResource QamPressedFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="FlatButtonBackground.Background" Value="{StaticResource QamSectionBrush}" />
                                        <Setter Target="FlatButtonContent.Foreground" Value="{StaticResource QamDisabledTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="FlatButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="FlatButtonContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QamTileButtonStyle" TargetType="Button" BasedOn="{StaticResource QamFlatButtonStyle}">
        <Setter Property="Padding" Value="{StaticResource QamTilePadding}" />
        <Setter Property="MinHeight" Value="{StaticResource QamTileMinHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource QamTileCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource QamTileBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="QamRailButtonStyle" TargetType="Button" BasedOn="{StaticResource QamFlatButtonStyle}">
        <Setter Property="Width" Value="{StaticResource QamRailButtonSize}" />
        <Setter Property="Height" Value="{StaticResource QamRailItemHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource QamRailButtonSize}" />
        <Setter Property="MinHeight" Value="{StaticResource QamRailItemHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource QamRailCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource QamSelectionBorderThickness}" />
        <Setter Property="BorderBrush" Value="{StaticResource QamFocusBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource QamSectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource QamRailIconBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Keep WinUI's native toggle template and input semantics; control-local theme brushes are
         applied by OverlayToggleRow so these colors never affect unrelated app controls. -->
    <Style x:Key="QamToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource QamToggleMinHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsFocusEngagementEnabled" Value="False" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- The native Slider template remains in charge of pointer/touch range interaction. -->
    <Style x:Key="QamSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="Background" Value="{StaticResource QamSliderTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource QamSliderValueTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource QamSliderHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsFocusEngagementEnabled" Value="False" />
    </Style>

    <!-- Shared by Button and RepeatButton without changing either control's activation behavior. -->
    <Style x:Key="QamValueButtonStyle" TargetType="primitives:ButtonBase">
        <Setter Property="MinWidth" Value="{StaticResource QamValueButtonWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource QamValueButtonHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource QamValueButtonCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource QamFocusBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource QamSectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource QamValueButtonForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsFocusEngagementEnabled" Value="False" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ButtonBase">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBackground.Background" Value="{StaticResource QamValueButtonHoverFill}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBackground.Background" Value="{StaticResource QamValueButtonPressedFill}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonBackground.Background" Value="{StaticResource QamSectionBrush}" />
                                        <Setter Target="ButtonContent.Foreground" Value="{StaticResource QamValueButtonDisabledForeground}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="ButtonContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
