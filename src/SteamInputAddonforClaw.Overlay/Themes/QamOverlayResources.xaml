<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="QamSurfaceBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamRailBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamContentBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamPrimaryTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="QamSecondaryTextBrush" Color="#FFDCDEDF" />
    <SolidColorBrush x:Key="QamDisabledTextBrush" Color="#FF969696" />
    <SolidColorBrush x:Key="QamErrorTextBrush" Color="#FF969696" />
    <SolidColorBrush x:Key="QamAccentBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamSelectedFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamHoverFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamPressedFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamFocusBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamSeparatorBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamSectionBrush" Color="#00000000" />
    <SolidColorBrush x:Key="QamTileBrush" Color="#FF0E141B" />
    <SolidColorBrush x:Key="QamTileSelectedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="QamRailIconBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamRailIconSelectedBrush" Color="#FF8B929A" />
    <SolidColorBrush x:Key="QamRailSelectedFillBrush" Color="#FF23262E" />

    <Thickness x:Key="QamContentPadding">16,16,16,12</Thickness>
    <x:Double x:Key="QamSectionSpacing">24</x:Double>
    <Thickness x:Key="QamSectionPadding">0</Thickness>
    <CornerRadius x:Key="QamSectionCornerRadius">0</CornerRadius>
    <x:Double x:Key="QamSectionHeaderSpacing">4</x:Double>
    <Thickness x:Key="QamDetailIndent">16,0,0,0</Thickness>
    <Thickness x:Key="QamDetailMargin">16,0,16,0</Thickness>
    <x:Double x:Key="QamRowSpacing">0</x:Double>
    <Thickness x:Key="QamRowPadding">10,16,10,16</Thickness>
    <Thickness x:Key="QamRowMargin">-16,0,-16,0</Thickness>
    <x:Double x:Key="QamRowMinHeight">42</x:Double>
    <CornerRadius x:Key="QamRowCornerRadius">2</CornerRadius>
    <Thickness x:Key="QamSelectionBorderThickness">0</Thickness>
    <x:Double x:Key="QamRailButtonSize">52</x:Double>
    <x:Double x:Key="QamRailItemHeight">64</x:Double>
    <x:Double x:Key="QamRailIconSize">24</x:Double>
    <x:Double x:Key="QamRailSpacing">0</x:Double>
    <CornerRadius x:Key="QamRailCornerRadius">0</CornerRadius>
    <Thickness x:Key="QamTilePadding">12</Thickness>
    <CornerRadius x:Key="QamTileCornerRadius">2</CornerRadius>
    <x:Double x:Key="QamTileMinHeight">58</x:Double>
    <x:Double x:Key="QamTileSpacing">8</x:Double>
    <x:Double x:Key="QamDisabledOpacity">0.48</x:Double>
    <FontFamily x:Key="QamFontFamily">Segoe UI Variable</FontFamily>

    <Style x:Key="QamBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource QamSecondaryTextBrush}" />
    </Style>
    <Style x:Key="QamBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource QamPrimaryTextBrush}" />
    </Style>
    <Style x:Key="QamCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource QamDisabledTextBrush}" />
    </Style>
    <Style x:Key="QamSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QamFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource QamPrimaryTextBrush}" />
    </Style>
    <Style x:Key="QamValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyTextStyle}" />
    <Style x:Key="QamTileTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QamBodyStrongTextStyle}" />

    <Style x:Key="QamRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource QamRailButtonSize}" />
        <Setter Property="Height" Value="{StaticResource QamRailItemHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource QamRailButtonSize}" />
        <Setter Property="MinHeight" Value="{StaticResource QamRailItemHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource QamRailCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource QamSelectionBorderThickness}" />
        <Setter Property="BorderBrush" Value="{StaticResource QamFocusBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource QamSectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource QamRailIconBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
