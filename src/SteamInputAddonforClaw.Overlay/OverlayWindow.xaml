<Window
    x:Class="SteamInputAddonforClaw.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AnimationViewport" RequestedTheme="Dark">
        <Grid
            x:Name="SurfaceHost"
            Background="{StaticResource QamSurfaceBrush}"
            SizeChanged="OnSurfaceHostSizeChanged">
            <Border
                x:Name="OpaquePanel"
                HorizontalAlignment="Stretch">
                <Grid x:Name="AnimatedContent">
                    <Grid x:Name="QamShell">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="TabRail"
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{StaticResource QamRailBrush}"
                            CornerRadius="{StaticResource QamRailCornerRadius}">
                            <Grid>
                                <TextBlock
                                    x:Name="RailClockText"
                                    Text="00:00"
                                    Style="{StaticResource QamCaptionTextStyle}"
                                    FontSize="12"
                                    HorizontalAlignment="Stretch"
                                    HorizontalTextAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,12,0,0"
                                    TextWrapping="NoWrap"
                                    IsHitTestVisible="False"
                                    IsTabStop="False" />
                                <StackPanel
                                    x:Name="TabRailCluster"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    Spacing="{StaticResource QamRailHintGap}">
                                    <FontIcon
                                        x:Name="PreviousTabBumperHint"
                                        Glyph="&#xF10C;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="{StaticResource QamRailHintIconSize}"
                                        Foreground="{StaticResource QamDisabledTextBrush}"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        AutomationProperties.Name="LB, previous tab" />
                                    <Grid
                                        x:Name="TabStrip"
                                        RowSpacing="{StaticResource QamRailSpacing}" />
                                    <FontIcon
                                        x:Name="NextTabBumperHint"
                                        Glyph="&#xF10D;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="{StaticResource QamRailHintIconSize}"
                                        Foreground="{StaticResource QamDisabledTextBrush}"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        AutomationProperties.Name="RB, next tab" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="ProfileContentColumn" Grid.Column="1" Grid.Row="0" SizeChanged="ProfileContentColumn_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="PageTitle"
                                Grid.Row="0"
                                Visibility="Visible"
                                Style="{StaticResource QamPageTitleTextStyle}"
                                Margin="{StaticResource QamPageTitleMargin}" />
                            <Grid
                                x:Name="ProfileArtworkHost"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <Image
                                    x:Name="ProfileArtworkImage"
                                    Stretch="UniformToFill"
                                    IsHitTestVisible="False" />
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#330E141B" Offset="0" />
                                            <GradientStop Color="#900E141B" Offset="0.5" />
                                            <GradientStop Color="#FF0E141B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <ScrollViewer
                                x:Name="BodyScroll"
                                Grid.Row="2"
                                Background="Transparent"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalContentAlignment="Stretch">
                                <Border
                                    Padding="{StaticResource QamBodyContentPadding}"
                                    HorizontalAlignment="Stretch">
                                    <Grid
                                        x:Name="TabBody"
                                        HorizontalAlignment="Stretch" />
                                </Border>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="QuickJumpFooter"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Height="36"
                            Background="{StaticResource QamRailBrush}"
                            IsHitTestVisible="False"
                            IsTabStop="False">
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Spacing="6"
                                IsHitTestVisible="False"
                                IsTabStop="False">
                                <FontIcon
                                    x:Name="YButtonFooterIcon"
                                    Glyph="&#xF095;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="20"
                                    Foreground="{StaticResource QamPrimaryTextBrush}"
                                    IsHitTestVisible="False" />
                                <TextBlock
                                    x:Name="YButtonFooterTargetText"
                                    Text="—"
                                    Style="{StaticResource QamBodyTextStyle}"
                                    FontSize="14"
                                    IsHitTestVisible="False"
                                    IsTabStop="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
