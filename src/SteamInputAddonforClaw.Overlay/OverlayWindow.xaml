<Window
    x:Class="SteamInputAddonforClaw.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AnimationViewport">
        <Grid x:Name="OpaquePanel" Background="#FFF3F3F3" Padding="28">
            <StackPanel x:Name="AnimatedContent" Spacing="16">
                <TextBlock Text="Addon Quick Settings" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Overlay POC-A" FontSize="18" />
                <TextBlock x:Name="GeometryText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
