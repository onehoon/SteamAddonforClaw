<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Dormant helper for OEM1 native-launch suppression (see docs handoff). Never enabled by
         default production startup in this PR: staged and started only by a future coordinator PR
         once armed. No window, no tray icon, no pipe, no MSI/WMI/registry/network calls, no child
         processes; it simply stays alive until externally terminated (owned Job Object or process
         handle), matching the research PoC's dummy process design exactly. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>CenterMHelper</AssemblyName>
    <RootNamespace>SteamInputAddonforClaw.CenterMHelper</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
</Project>
