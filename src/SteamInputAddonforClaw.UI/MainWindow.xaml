<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SteamInputAddonforClaw.Views"
    Title="Steam Input Addon for Claw">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
    <NavigationView
        x:Name="MainNavigationView"
        PaneDisplayMode="Left"
        Loaded="MainNavigationView_Loaded"
        PointerPressed="MainNavigationView_PointerPressed"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="StatusNavigationItem"
                Content="Status"
                Tag="Status">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="How to Use" Tag="HowToUse">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Controller" Tag="Controller">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Device" Tag="Device">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Profile" Tag="Profile">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <views:StatusPage x:Name="StatusContent" />

            <views:DevicePage x:Name="DeviceContent" Visibility="Collapsed" />

            <views:ProfilePage x:Name="ProfileContent" Visibility="Collapsed" />

            <views:HowToUsePage x:Name="HowToUseContent" Visibility="Collapsed" />

            <views:ControllerPage x:Name="ControllerContent" Visibility="Collapsed" />

            <views:CenterMButtonPage x:Name="CenterMButtonContent" Visibility="Collapsed" />

            <views:SettingsPage x:Name="SettingsContent" Visibility="Collapsed" />

            <views:DeveloperPage x:Name="DeveloperMenuContent" Visibility="Collapsed" />
            <views:VibrationTestPage x:Name="VibrationTestContent" Visibility="Collapsed" />
            <views:ClawSensorProbePage x:Name="ClawSensorProbeContent" Visibility="Collapsed" />
        </Grid>
    </NavigationView>
        <Grid x:Name="PrerequisiteSetupBusyOverlay"
              Canvas.ZIndex="100"
              Background="#99000000"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="Installing required components…"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Please wait. This may take a moment."
                           Foreground="White"
                           Opacity="0.9"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
