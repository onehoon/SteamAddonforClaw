<Window
    x:Class="SteamInputAddonforClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SteamInputAddonforClaw.Views"
    Title="Steam Addon for Claw">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="MainAppRoot" XYFocusKeyboardNavigation="Enabled" Loaded="MainAppRoot_Loaded">
    <NavigationView
        x:Name="MainNavigationView"
        PaneDisplayMode="Left"
        HorizontalContentAlignment="Stretch"
        Loaded="MainNavigationView_Loaded"
        PointerPressed="MainNavigationView_PointerPressed"
        SelectionChanged="MainNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DeviceNavigationItem"
                x:Uid="MainNav_Device"
                Content="Device"
                Tag="Device">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE772;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainNav_Controller" Content="Controller" Tag="Controller">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainNav_Steam" Content="Steam" Tag="Profile">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainNav_Xbox" Content="XBOX" Tag="Xbox">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE990;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="MainNav_ClawHud" Content="ClawHUD" Tag="Overlay">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Shortcut" Tag="Shortcut">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Tweaks" Tag="Tweaks">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="How to Use" Tag="HowToUse">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <views:DevicePage x:Name="DeviceContent" />

            <ContentControl x:Name="ControllerPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="ProfilePageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="XboxPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="OverlayPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="ShortcutPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="TweaksPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="SettingsPageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="HowToUsePageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />

            <ContentControl
                x:Name="DeveloperContentHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </NavigationView>
        <Grid x:Name="PrerequisiteSetupBusyOverlay"
              Canvas.ZIndex="100"
              Background="#99000000"
              Visibility="Collapsed"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="Installing required components…"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Please wait. This may take a moment."
                           Foreground="White"
                           Opacity="0.9"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
