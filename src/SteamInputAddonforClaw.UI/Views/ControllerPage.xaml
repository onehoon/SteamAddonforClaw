<UserControl
    x:Class="SteamInputAddonforClaw.Views.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:SteamInputAddonforClaw.Views">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Controller" />
                <TextBlock Opacity="0.7" Text="Configure Steam Input controller routing." TextWrapping="Wrap" />
            </StackPanel>
            <ctcontrols:SettingsExpander x:Name="SteamInputRoutingExpander" Header="Steam Input Routing" IsExpanded="True" Description="Automatically route the built-in controller through Steam Input for Steam games and Big Picture Mode.&#xA;Xbox Game Bar is disabled during routing, and the Game Bar button action is configured below.">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="SteamInputRoutingToggleSwitch" OffContent="" OnContent="" Toggled="SteamInputRoutingToggleSwitch_Toggled" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Routing Button Behavior" Description="During active Steam Input Routing (Steam game or Big Picture Mode), these button assignments are fixed and cannot be customized.">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WING Button    Steam Button" />
                            <TextBlock Text="Center M Button    Steam Quick Access" />
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <!--
                The toggle changes ONLY the global remapping switch; clicking anywhere else on the
                card (the chevron area) opens the detail page. IsClickEnabled gives the card the
                standard Windows 11 navigation chevron, and the nested ToggleSwitch keeps its own
                click for itself.
            -->
            <views:CenterMButtonPage x:Name="CenterMInlineContent" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
