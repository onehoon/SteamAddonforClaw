<UserControl
    x:Class="SteamInputAddonforClaw.Views.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Controller" />
                <TextBlock Opacity="0.7" Text="Configure how Steam Input routing behaves outside a running game." TextWrapping="Wrap" />
            </StackPanel>
            <ctcontrols:SettingsCard Header="Steam Big Picture Mode" Description="Keep Steam Controller routing active in Big Picture, even when no game is running.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="RouteInSteamBigPictureToggleSwitch" OffContent="" OnContent="" Toggled="RouteInSteamBigPictureToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
