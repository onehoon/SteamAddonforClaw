<UserControl x:Class="SteamInputAddonforClaw.Views.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Controller_PageTitle" FontSize="24" FontWeight="SemiBold" Text="Controller" />
                <TextBlock x:Uid="Controller_PageDescription" Opacity="0.7" Text="Configure controller buttons and controller-specific settings." TextWrapping="Wrap" />
            </StackPanel>

            <ctcontrols:SettingsCard x:Name="SteamVirtualControllerCard" x:Uid="Controller_SteamVirtualControllerCard" Header="Steam Virtual Controller">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ctcontrols:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Controller_SteamVirtualControllerDescription" Text="Choose the virtual controller used by Steam." />
                        <TextBlock x:Name="SteamVirtualControllerActivityText" x:Uid="Controller_SteamVirtualControllerActivity" Text="Selection is disabled while a Steam game or Big Picture Mode is active." />
                    </StackPanel>
                </ctcontrols:SettingsCard.Description>
                <ComboBox x:Name="SteamVirtualControllerComboBox" MinWidth="240" SelectionChanged="SteamVirtualControllerComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Controller_SteamDeckOption" Content="Steam Deck (Default)" Tag="SteamDeck" />
                    <ComboBoxItem x:Uid="Controller_DualSenseEdgeOption" Content="DualSense Edge" Tag="DualSenseEdge" />
                </ComboBox>
            </ctcontrols:SettingsCard>
            <InfoBar x:Name="SteamVirtualControllerInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />

            <TextBlock x:Name="MappingUnavailableText" x:Uid="Controller_MappingUnavailable" Text="Unavailable" FontWeight="SemiBold" Visibility="Collapsed" />

            <StackPanel x:Name="MappingContent" Spacing="12">
                <TextBlock x:Uid="Controller_ButtonMappingHeader" Text="Button Mapping" FontSize="18" FontWeight="SemiBold" />

                <StackPanel x:Name="FrontButtonMappingContent" Spacing="12">
                <ctcontrols:SettingsExpander x:Uid="Controller_GamebarExpander" Header="Gamebar Button" Description="The action for the Gamebar button, per runtime presentation domain." IsExpanded="False">
                    <ctcontrols:SettingsExpander.HeaderIcon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE990;" /></ctcontrols:SettingsExpander.HeaderIcon>
                    <ctcontrols:SettingsExpander.Items>
                        <ctcontrols:SettingsCard x:Uid="Controller_GamebarNormalCard" Header="Normal">
                            <ComboBox x:Name="GamebarNormalActionComboBox" MinWidth="220" SelectionChanged="ActionComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Name="GamebarNormalConfigCard" ContentAlignment="Vertical">
                            <StackPanel x:Name="GamebarNormalConfigPanel" Spacing="8" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Uid="Controller_GamebarSteamCard" Header="Steam Game / Big Picture">
                            <ComboBox x:Name="GamebarSteamActionComboBox" MinWidth="220" SelectionChanged="ActionComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Name="GamebarSteamConfigCard" ContentAlignment="Vertical">
                            <StackPanel x:Name="GamebarSteamConfigPanel" Spacing="8" />
                        </ctcontrols:SettingsCard>
                    </ctcontrols:SettingsExpander.Items>
                </ctcontrols:SettingsExpander>

                <ctcontrols:SettingsExpander x:Uid="Controller_CenterMExpander" Header="Center M Button" Description="The action for the Center M button, per runtime presentation domain." IsExpanded="False">
                    <ctcontrols:SettingsExpander.HeaderIcon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B0;" /></ctcontrols:SettingsExpander.HeaderIcon>
                    <ctcontrols:SettingsExpander.Items>
                        <ctcontrols:SettingsCard x:Uid="Controller_CenterMNormalCard" Header="Normal">
                            <ComboBox x:Name="CenterMNormalActionComboBox" MinWidth="220" SelectionChanged="ActionComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Name="CenterMNormalConfigCard" ContentAlignment="Vertical">
                            <StackPanel x:Name="CenterMNormalConfigPanel" Spacing="8" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Uid="Controller_CenterMSteamCard" Header="Steam Game / Big Picture">
                            <ComboBox x:Name="CenterMSteamActionComboBox" MinWidth="220" SelectionChanged="ActionComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Name="CenterMSteamConfigCard" ContentAlignment="Vertical">
                            <StackPanel x:Name="CenterMSteamConfigPanel" Spacing="8" />
                        </ctcontrols:SettingsCard>
                    </ctcontrols:SettingsExpander.Items>
                </ctcontrols:SettingsExpander>
                </StackPanel>

                <ctcontrols:SettingsExpander
                    x:Name="BackButtonMappingExpander"
                    x:Uid="Controller_BackButtonMappingExpander"
                    Header="M1 / M2"
                    Description="Xbox 360 mode only. Steam Game / Big Picture keeps M1 as R4 and M2 as L4."
                    IsExpanded="False">
                    <ctcontrols:SettingsExpander.HeaderIcon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;" /></ctcontrols:SettingsExpander.HeaderIcon>
                    <ctcontrols:SettingsExpander.Items>
                        <ctcontrols:SettingsCard x:Uid="Controller_M1Card" Header="M1">
                            <ComboBox
                                x:Name="M1TargetComboBox"
                                MinWidth="220"
                                SelectionChanged="BackButtonTargetComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Uid="Controller_M2Card" Header="M2">
                            <ComboBox
                                x:Name="M2TargetComboBox"
                                MinWidth="220"
                                SelectionChanged="BackButtonTargetComboBox_SelectionChanged" />
                        </ctcontrols:SettingsCard>
                    </ctcontrols:SettingsExpander.Items>
                </ctcontrols:SettingsExpander>

                <TextBlock x:Name="ControllerSettingsHeader" x:Uid="Controller_SettingsHeader" Text="Controller Settings" FontSize="18" Visibility="Collapsed" />
                <ctcontrols:SettingsExpander
                    x:Name="ControllerLedExpander"
                    x:Uid="Controller_LedExpander"
                    Header="Joystick LED"
                    Description="Set one static color and global brightness for all controller LEDs."
                    IsExpanded="False"
                    Visibility="Collapsed">
                    <ctcontrols:SettingsExpander.HeaderIcon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE781;" /></ctcontrols:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="ControllerLedEnabledToggle" OffContent="" OnContent="" Toggled="ControllerLedEnabled_Toggled" />
                    <ctcontrols:SettingsExpander.Items>
                        <ctcontrols:SettingsCard x:Uid="Controller_LedBrightnessCard" Header="Brightness">
                            <StackPanel MinWidth="260" Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="ControllerLedBrightnessSlider" Minimum="0" Maximum="100" Width="220" ValueChanged="ControllerLedBrightness_ValueChanged" />
                                <TextBlock x:Name="ControllerLedBrightnessValue" MinWidth="28" VerticalAlignment="Center" />
                            </StackPanel>
                        </ctcontrols:SettingsCard>
                        <ctcontrols:SettingsCard x:Uid="Controller_LedColorCard" Header="Color">
                            <Button x:Name="ControllerLedColorButton">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="ControllerLedColorPicker" IsAlphaEnabled="False" ColorChanged="ControllerLedColor_Changed" />
                                    </Flyout>
                                </Button.Flyout>
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border x:Name="ControllerLedColorSwatch" Width="28" Height="20" BorderBrush="Gray" BorderThickness="1" />
                                        <TextBlock x:Uid="Controller_LedChooseColor" Text="Choose color" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </ctcontrols:SettingsCard>
                    </ctcontrols:SettingsExpander.Items>
                </ctcontrols:SettingsExpander>
            </StackPanel>

            <ctcontrols:SettingsExpander
                x:Name="VibrationStrengthExpander"
                x:Uid="Controller_VibrationStrengthExpander"
                Header="Vibration Strength"
                Description="Set the vibration strength applied while the Addon owns the controller."
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE877;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard x:Uid="Controller_LeftMotorCard" Header="Left Motor">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="LeftVibrationStrengthSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Visibility="Collapsed"
                                ValueChanged="VibrationStrengthSlider_ValueChanged" />
                            <TextBlock
                                x:Name="LeftVibrationStrengthPercentText"
                                Grid.Column="1"
                                Text="—"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button
                                x:Name="LeftVibrationTestButton"
                                x:Uid="Controller_LeftMotorTestButton"
                                Grid.Column="2"
                                Content="Test"
                                Click="LeftVibrationTestButton_Click" />
                        </Grid>
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Uid="Controller_RightMotorCard" Header="Right Motor">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="RightVibrationStrengthSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Visibility="Collapsed"
                                ValueChanged="VibrationStrengthSlider_ValueChanged" />
                            <TextBlock
                                x:Name="RightVibrationStrengthPercentText"
                                Grid.Column="1"
                                Text="—"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                            <Button
                                x:Name="RightVibrationTestButton"
                                x:Uid="Controller_RightMotorTestButton"
                                Grid.Column="2"
                                Content="Test"
                                Click="RightVibrationTestButton_Click" />
                        </Grid>
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Uid="Controller_VibrationRecoveryCard" Header="Vibration Recovery">
                        <Button
                            x:Name="RestoreVibrationButton"
                            x:Uid="Controller_RestoreVibrationButton"
                            Content="Restore Vibration"
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="Temporarily disconnects virtual controller input. Save and close your game first."
                            Click="RestoreVibrationButton_Click" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>
            <InfoBar
                x:Name="VibrationStrengthInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Message="" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
