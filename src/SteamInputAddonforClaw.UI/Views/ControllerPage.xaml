<UserControl
    x:Class="SteamInputAddonforClaw.Views.ControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Controller" />
                <TextBlock Opacity="0.7" Text="Configure Steam Input controller routing." TextWrapping="Wrap" />
            </StackPanel>
            <ctcontrols:SettingsCard Header="Steam Input Routing" Description="Automatically route the built-in controller through Steam Input for Steam games and Big Picture Mode.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="SteamInputRoutingToggleSwitch" OffContent="" OnContent="" Toggled="SteamInputRoutingToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
