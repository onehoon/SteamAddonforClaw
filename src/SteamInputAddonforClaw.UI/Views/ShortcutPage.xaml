<UserControl
    x:Class="SteamInputAddonforClaw.Views.ShortcutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:frontend="using:SteamInputAddonforClaw.Contracts.Frontend">
    <Grid Padding="32" RowSpacing="16" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Shortcut" />
                <TextBlock Opacity="0.7" Text="Create and organize actions shown in the Shortcut overlay page." TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AddShortcutButton" Grid.Column="1" Content="＋ Add Shortcut" Click="AddShortcutButton_Click" />
        </Grid>

        <InfoBar
            x:Name="ShortcutInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="ShortcutList"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                DragItemsCompleted="ShortcutList_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="frontend:FrontendShortcutEditorTile">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    Glyph="&#xE7C3;"
                                    Opacity="0.65"
                                    AutomationProperties.Name="Drag to reorder" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Opacity="0.75" Text="{x:Bind TargetSummary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{x:Bind Action.ValidationMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Edit" Tag="{x:Bind TileId}" IsEnabled="{x:Bind Action.Editable}" Click="EditTileButton_Click" />
                                    <Button Content="Delete" Tag="{x:Bind TileId}" Click="DeleteTileButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="ShortcutEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" FontSize="18" Text="No shortcuts yet." />
                <TextBlock HorizontalAlignment="Center" Opacity="0.7" Text="Add a Shortcut to get started." />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="24" RowSpacing="12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Screenshot" />
                    <TextBlock Opacity="0.75" Text="Captures the primary display as JPEG. Choose the folder used by Screenshot shortcuts." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BrowseScreenshotFolderButton" Content="Browse…" Click="BrowseScreenshotFolderButton_Click" />
                    <Button x:Name="UseDefaultFolderButton" Content="Use default" Click="UseDefaultFolderButton_Click" />
                    <Button x:Name="OpenScreenshotFolderButton" Content="Open folder" Click="OpenScreenshotFolderButton_Click" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock x:Name="ScreenshotFolderPathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="ScreenshotFolderModeText" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
