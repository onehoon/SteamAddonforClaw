<UserControl
    x:Class="SteamInputAddonforClaw.Views.HowToUsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid x:Name="DocumentationWebViewHost" />

        <StackPanel x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <ProgressRing IsActive="True" />
            <TextBlock x:Uid="HowToUse_Loading" Text="Loading documentation…" />
        </StackPanel>

        <StackPanel x:Name="FailurePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <TextBlock x:Uid="HowToUse_Failure" Text="How to Use could not be loaded."
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <Button x:Uid="HowToUse_Retry" Content="Retry" Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
