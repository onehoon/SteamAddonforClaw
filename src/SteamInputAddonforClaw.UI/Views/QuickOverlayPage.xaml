<UserControl
    x:Class="SteamInputAddonforClaw.Views.QuickOverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="QuickOverlay_PageTitle" FontSize="24" FontWeight="SemiBold" Text="Quick Overlay" />

            <ctcontrols:SettingsCard
                x:Name="YButtonQuickJumpCard"
                x:Uid="QuickOverlay_YButtonQuickJumpCard"
                Description="Press Y to jump to the selected tab while Quick Overlay is open."
                Header="Y Button Quick Jump">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7FC;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="YButtonQuickJumpComboBox"
                    x:Uid="QuickOverlay_YButtonQuickJumpComboBox"
                    SelectionChanged="YButtonQuickJumpComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Profile" Content="Profile" Tag="Profile" />
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Shortcut" Content="Shortcut" Tag="Shortcut" />
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Device" Content="Device" Tag="Device" />
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Controller" Content="Controller" Tag="Controller" />
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Setting" Content="Setting" Tag="Setting" />
                    <ComboBoxItem x:Uid="QuickOverlay_YButtonQuickJump_Off" Content="Off" Tag="Off" />
                </ComboBox>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard
                x:Name="QuickSettingsPowerSourceCard"
                x:Uid="QuickOverlay_PowerSourceCard"
                Description="Show only the controls for the currently connected power source in Quick Settings Overlay."
                Header="Show only current power source">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE85E;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="QuickSettingsPowerSourceToggleSwitch"
                    OffContent=""
                    OnContent=""
                    Toggled="QuickSettingsPowerSourceToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander
                x:Name="QuickOverlayTabOrderExpander"
                x:Uid="QuickOverlay_TabOrderExpander"
                Description="Set the tab order and which tab opens first."
                Header="Quick Overlay Tab Order"
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="List" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <TextBlock
                        x:Name="QuickOverlayTabOrderStatusText"
                        x:Uid="QuickOverlay_TabOrderStatusText"
                        Text="Loading tab order…" />
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
