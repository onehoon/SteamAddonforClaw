<UserControl
    x:Class="SteamInputAddonforClaw.Views.GameInputSystemButtonProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
            <TextBlock Text="GameInput System Button Probe" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Press WING Guide or Share while this probe is running. GameInput button callbacks include the source device identity; no input is suppressed or redirected by this probe." TextWrapping="Wrap" Opacity="0.75" />
            <TextBlock Text="Enable Debug logging before Start so the complete callback timeline is recorded in the Runtime log." TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="EventCountText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Content="Start" Click="Start_Click" />
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Last event" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="LastEventText" TextWrapping="Wrap" FontFamily="Consolas" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
