<UserControl
    x:Class="SteamInputAddonforClaw.Views.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer
        Padding="32"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button
                Click="BackButton_Click"
                Content="Back to Settings"
                HorizontalAlignment="Left" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Developer Menu" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OpenLogFolderButton_Click" Content="Log Folder" VerticalAlignment="Center" />
            </Grid>
            <TextBlock
                Opacity="0.7"
                Text="These diagnostics are for developers only. General users should not use this menu."
                TextWrapping="Wrap" />

            <ctcontrols:SettingsCard Header="Virtual Touchpad (Experimental)" Description="Right quarter of the primary touchscreen. Active only during a foreground Steam game with a live Steam Deck virtual controller; not in BPM browsing, Xbox360, or DualSense Edge.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="TouchPointer" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="ExperimentalVirtualTouchpadToggle" OffContent="" OnContent="" Toggled="ExperimentalVirtualTouchpadToggle_Toggled" />
                    <TextBlock x:Name="ExperimentalVirtualTouchpadStatusText" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Find" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Environment Discovery" />
                        <TextBlock Opacity="0.7" Text="Generate a read-only system report for controller software detection development." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                        <Button x:Name="GenerateEnvironmentDiscoveryReportButton" Click="GenerateEnvironmentDiscoveryReportButton_Click" Content="Generate Report" FontWeight="Normal" HorizontalAlignment="Right" />
                        <TextBlock x:Name="EnvironmentDiscoveryReportStatusText" HorizontalAlignment="Right" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <ctcontrols:SettingsCard Header="Gyro / Sensor Test" Description="Read-only diagnostic for MSI Claw gyroscope and accelerometer discovery and motion capture.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Rotate" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenSensorProbeButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Fan Hardware Probe" Description="Developer-only MSI fan EC/WMI diagnostics. Bounded writes always return to MSI firmware Auto.">
                <ctcontrols:SettingsCard.HeaderIcon><SymbolIcon Symbol="Repair" /></ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenFanHardwareProbeButton_Click" />
            </ctcontrols:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
