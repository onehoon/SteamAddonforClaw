<UserControl
    x:Class="SteamInputAddonforClaw.Views.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer
        Padding="32"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button
                Click="BackButton_Click"
                Content="Back to Settings"
                HorizontalAlignment="Left" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Developer Menu" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OpenLogFolderButton_Click" Content="Log Folder" VerticalAlignment="Center" />
            </Grid>
            <TextBlock
                Opacity="0.7"
                Text="These diagnostics are for developers only. General users should not use this menu."
                TextWrapping="Wrap" />

            <Border Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <SymbolIcon VerticalAlignment="Center" Symbol="Find" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Environment Discovery" />
                        <TextBlock Opacity="0.7" Text="Generate a read-only system report for controller software detection development." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                        <Button x:Name="GenerateEnvironmentDiscoveryReportButton" Click="GenerateEnvironmentDiscoveryReportButton_Click" Content="Generate Report" FontWeight="Normal" HorizontalAlignment="Right" />
                        <TextBlock x:Name="EnvironmentDiscoveryReportStatusText" HorizontalAlignment="Right" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <ctcontrols:SettingsCard Header="PID1902 Input Cadence" Description="Measure distinct raw DirectInput state changes by temporarily oversampling the existing physical controller for 10 seconds. Close games or use a safe screen. Continuously move both sticks and LT/RT during the test.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Spacing="6">
                    <Button x:Name="RunPid1902InputCadenceButton" Click="RunPid1902InputCadenceButton_Click" Content="Run 10s Test" />
                    <TextBlock x:Name="Pid1902InputCadenceStatusText" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Vibration Test" Description="Run the Full1902 Xbox360 terminal STOP callback diagnostic. Close games and other XInput rumble tools first.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE1D9;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenVibrationTestButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Gyro / Sensor Test" Description="Read-only diagnostic for MSI Claw gyroscope and accelerometer discovery and motion capture.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Rotate" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenSensorProbeButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Fan Hardware Probe" Description="Developer-only MSI fan EC/WMI diagnostics. Bounded writes always return to MSI firmware Auto.">
                <ctcontrols:SettingsCard.HeaderIcon><SymbolIcon Symbol="Repair" /></ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenFanHardwareProbeButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Battery Charge Limit Test" Description="Developer-only MSI battery charge-limit read/write validation. Changes apply immediately and remain until changed.">
                <ctcontrols:SettingsCard.HeaderIcon><SymbolIcon Symbol="AllApps" /></ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenBatteryChargeLimitTestButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="GameInput System Button Probe" Description="Identify which GameInput device emits Guide/Share when WING is pressed.">
                <ctcontrols:SettingsCard.HeaderIcon><SymbolIcon Symbol="Keyboard" /></ctcontrols:SettingsCard.HeaderIcon>
                <Button Content="Open" Click="OpenGameInputSystemButtonProbeButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Intel GPU Frequency / IGCL Probe" Description="Developer-only official IGCL read/write test. A hard Runtime crash can leave a test range applied; normal shutdown attempts restoration. PL1 is a power ceiling, not a GPU power reservation.">
                <ctcontrols:SettingsCard.HeaderIcon><SymbolIcon Symbol="Repair" /></ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="IntelGpuFrequencyProbeDetailsText" FontFamily="Consolas" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshIntelGpuFrequencyProbeButton" Click="RefreshIntelGpuFrequencyProbeButton_Click" Content="Refresh" />
                        <Button x:Name="SetIntelGpuMaxMaxButton" Click="SetIntelGpuMaxMaxButton_Click" Content="Set Max / Max + Readback" />
                        <Button x:Name="RestoreIntelGpuFrequencyButton" Click="RestoreIntelGpuFrequencyButton_Click" Content="Restore Original Frequency" />
                    </StackPanel>
                    <TextBlock Text="GPU Power Limit (PL1)" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumberBox x:Name="IntelGpuTestPl1NumberBox" Width="160" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Inline" ValueChanged="IntelGpuTestPl1NumberBox_ValueChanged" />
                        <TextBlock Text="mW" VerticalAlignment="Center" />
                        <Button x:Name="SetIntelGpuTestPl1Button" Click="SetIntelGpuTestPl1Button_Click" Content="Set Test PL1 + Readback" />
                        <Button x:Name="RestoreIntelGpuPowerButton" Click="RestoreIntelGpuPowerButton_Click" Content="Restore Original Power" />
                    </StackPanel>
                    <TextBlock x:Name="IntelGpuFrequencyProbeStatusText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Logging" Description="Off by default. Info enables runtime diagnostics; Debug is verbose and for developer use only.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="List" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LogLevelComboBox" Width="120" VerticalAlignment="Center" SelectionChanged="LogLevelComboBox_SelectionChanged">
                    <ComboBoxItem Content="Off" />
                    <ComboBoxItem Content="Info" />
                    <ComboBoxItem Content="Debug" />
                </ComboBox>
            </ctcontrols:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
