<UserControl
    x:Class="SteamInputAddonforClaw.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Device" />

            <InfoBar x:Name="CpuBoostInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />

            <ctcontrols:SettingsExpander
                x:Name="CpuBoostExpander"
                Header="CPU Boost"
                Description="Processor performance boost mode."
                IsExpanded="True">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE945;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    x:Name="CpuBoostEnabledToggleSwitch"
                    OffContent=""
                    OnContent=""
                    Toggled="CpuBoostEnabledToggleSwitch_Toggled" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Plugged in">
                        <ComboBox
                            x:Name="CpuBoostAcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="CpuBoostAcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard Header="On battery">
                        <ComboBox
                            x:Name="CpuBoostDcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="CpuBoostDcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <InfoBar x:Name="TdpInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />
            <ctcontrols:SettingsExpander x:Name="TdpExpander" Header="TDP Control"
                Description="Configure processor power limits for plugged-in and battery operation.">
                <ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE945;" /></ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="TdpEnabledToggleSwitch" OffContent="" OnContent="" Toggled="TdpEnabledToggleSwitch_Toggled" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard Header="Plugged in">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="PL1" VerticalAlignment="Center"/><Slider x:Name="TdpAcPl1Slider" Grid.Column="1" ValueChanged="TdpSlider_ValueChanged"/><TextBlock x:Name="TdpAcPl1ValueText" Grid.Column="2" Text="— W" VerticalAlignment="Center"/></Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="PL2" VerticalAlignment="Center"/><Slider x:Name="TdpAcPl2Slider" Grid.Column="1" ValueChanged="TdpSlider_ValueChanged"/><TextBlock x:Name="TdpAcPl2ValueText" Grid.Column="2" Text="— W" VerticalAlignment="Center"/></Grid>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard Header="On battery">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="PL1" VerticalAlignment="Center"/><Slider x:Name="TdpDcPl1Slider" Grid.Column="1" ValueChanged="TdpSlider_ValueChanged"/><TextBlock x:Name="TdpDcPl1ValueText" Grid.Column="2" Text="— W" VerticalAlignment="Center"/></Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="PL2" VerticalAlignment="Center"/><Slider x:Name="TdpDcPl2Slider" Grid.Column="1" ValueChanged="TdpSlider_ValueChanged"/><TextBlock x:Name="TdpDcPl2ValueText" Grid.Column="2" Text="— W" VerticalAlignment="Center"/></Grid>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
