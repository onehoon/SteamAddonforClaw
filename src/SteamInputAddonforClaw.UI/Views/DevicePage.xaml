<UserControl
    x:Class="SteamInputAddonforClaw.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <Style x:Key="DeviceSummaryIndicatorNeutralStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DeviceSummaryIndicatorSuccessStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="DeviceSummaryIndicatorCautionStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="DeviceSummaryIndicatorCriticalStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="32">
        <StackPanel Spacing="8">
            <TextBlock x:Uid="Device_PageTitle" FontSize="24" FontWeight="SemiBold" Text="Device" />

            <Border x:Name="DeviceSummaryCard" Padding="18,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="8" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DeviceManufacturerText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceModelText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="DeviceBoardGpuText" Grid.Row="1" Grid.ColumnSpan="2" Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel Grid.RowSpan="2" Grid.Column="2" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="DeviceSupportIndicator" Width="8" Height="8" Style="{StaticResource DeviceSummaryIndicatorNeutralStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeviceSupportText" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="AutoStartStatusIndicator" Width="8" Height="8" Style="{StaticResource DeviceSummaryIndicatorNeutralStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AutoStartStatusText" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="AutoStartRepairButton" x:Uid="Device_AutoStartRepairButton" Content="Repair" Padding="8,2" MinHeight="24" FontSize="12" Visibility="Collapsed" Click="AutoStartRepairButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="CenterMStartupInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Informational" />
            <ctcontrols:SettingsCard x:Name="CenterMStartupCard" x:Uid="Device_CenterMStartupCard" Header="MSI Center M">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="CenterMStartupStatusText" x:Uid="Device_CenterMStartupStatusText" VerticalAlignment="Center" Text="Status: —" />
                    <Button x:Name="CenterMStartupEnableButton" x:Uid="Device_CenterMStartupEnableButton" Content="Enable" Click="CenterMStartupEnableButton_Click" />
                    <Button x:Name="CenterMStartupDisableButton" x:Uid="Device_CenterMStartupDisableButton" Content="Disable" Click="CenterMStartupDisableButton_Click" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <InfoBar x:Name="TdpInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning" />
            <ctcontrols:SettingsCard x:Name="TdpCard" x:Uid="Device_TdpCard" Header="TDP Control">
                <ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander x:Name="TdpExpander" x:Uid="Device_TdpExpander" Header="TDP Control" IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE945;" /></ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="TdpEnabledToggleSwitch" Visibility="Collapsed" OffContent="" OnContent="" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard x:Name="TdpAcExpandedCard">
                        <StackPanel x:Name="TdpAcCard" Spacing="6">
                            <TextBlock x:Uid="Device_TdpAcRailLabel" Text="AC" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TdpAcPl1ValueText" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="TdpAcPl1ResultText" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="TdpAcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid>
                            <Grid x:Name="TdpAcPl2Row" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TdpAcPl2ValueText" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="TdpAcPl2ResultText" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="TdpAcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Name="TdpDcExpandedCard">
                        <StackPanel x:Name="TdpDcCard" Spacing="6">
                            <TextBlock x:Uid="Device_TdpDcRailLabel" Text="DC" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TdpDcPl1ValueText" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="TdpDcPl1ResultText" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="TdpDcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid>
                            <Grid x:Name="TdpDcPl2Row" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TdpDcPl2ValueText" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="TdpDcPl2ResultText" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="TdpDcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid>
                        </StackPanel>
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <InfoBar x:Name="CpuBoostInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning" />

            <ctcontrols:SettingsExpander
                x:Name="CpuBoostExpander"
                x:Uid="Device_CpuBoostExpander"
                Header="CPU Boost"
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEEA1;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    x:Name="CpuBoostEnabledToggleSwitch"
                    Visibility="Collapsed"
                    OffContent=""
                    OnContent="" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard x:Name="CpuBoostAcCard" x:Uid="Device_CpuBoostAcCard" Header="AC">
                        <ComboBox
                            x:Name="CpuBoostAcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="CpuBoostAcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Name="CpuBoostDcCard" x:Uid="Device_CpuBoostDcCard" Header="DC">
                        <ComboBox
                            x:Name="CpuBoostDcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="CpuBoostDcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard x:Name="CpuBoostCard" x:Uid="Device_CpuBoostCard" Header="CPU Boost">
                <ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEEA1;" /></ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>

            <InfoBar x:Name="MaximumProcessorStateInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning" />
            <ctcontrols:SettingsExpander
                x:Name="MaximumProcessorStateExpander"
                x:Uid="Device_MaximumProcessorStateExpander"
                Header="Maximum Processor State"
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xF42F;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard x:Name="MaximumProcessorStateAcCard" x:Uid="Device_MaximumProcessorStateAcCard" Header="AC">
                        <ComboBox
                            x:Name="MaximumProcessorStateAcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="MaximumProcessorStateAcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Name="MaximumProcessorStateDcCard" x:Uid="Device_MaximumProcessorStateDcCard" Header="DC">
                        <ComboBox
                            x:Name="MaximumProcessorStateDcComboBox"
                            MinWidth="220"
                            DisplayMemberPath="Label"
                            SelectionChanged="MaximumProcessorStateDcComboBox_SelectionChanged" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard x:Name="MaximumProcessorStateCard" x:Uid="Device_MaximumProcessorStateCard" Header="Maximum Processor State">
                <ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF42F;" /></ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>

            <InfoBar x:Name="PowerModeInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning" />
            <ctcontrols:SettingsExpander x:Name="PowerModeExpander" x:Uid="Device_PowerModeExpander" Header="Windows Power Mode" IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="PowerModeEnabledToggleSwitch" Visibility="Collapsed" OffContent="" OnContent="" />
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard x:Name="PowerModeAcCard" x:Uid="Device_PowerModeAcCard" Header="AC"><ComboBox x:Name="PowerModeAcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeAcComboBox_SelectionChanged" /></ctcontrols:SettingsCard>
                    <ctcontrols:SettingsCard x:Name="PowerModeDcCard" x:Uid="Device_PowerModeDcCard" Header="DC"><ComboBox x:Name="PowerModeDcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeDcComboBox_SelectionChanged" /></ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard x:Name="PowerModeCard" x:Uid="Device_PowerModeCard" Header="Windows Power Mode">
                <ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>

            <InfoBar x:Name="BatteryChargeLimitInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning" />
            <ctcontrols:SettingsCard x:Name="BatteryChargeLimitCard" x:Uid="Device_BatteryChargeLimitCard" Header="Battery charge limit">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE86B;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="BatteryChargeLimitValueText" MinWidth="64" Text="—%" VerticalAlignment="Center" />
                    <Slider x:Name="BatteryChargeLimitSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="60" Maximum="100" StepFrequency="5" ValueChanged="BatteryChargeLimitSlider_ValueChanged" PointerCaptureLost="BatteryChargeLimitSlider_PointerCaptureLost" KeyUp="BatteryChargeLimitSlider_KeyUp" />
                    <ToggleSwitch x:Name="BatteryChargeLimitEnabledToggleSwitch" Grid.Column="2" VerticalAlignment="Center" OffContent="" OnContent="" Toggled="BatteryChargeLimitEnabledToggleSwitch_Toggled" />
                </Grid>
            </ctcontrols:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
