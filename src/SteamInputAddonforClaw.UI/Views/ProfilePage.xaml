<UserControl x:Class="SteamInputAddonforClaw.Views.ProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
<Grid Padding="20,16" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<InfoBar x:Name="ProfileInfoBar" Grid.Row="0" IsClosable="False" IsOpen="False" Severity="Warning"/>
<Grid Grid.Row="1">
<Grid x:Name="CatalogPanel">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="24" FontWeight="SemiBold" Text="Profile"/><Button x:Name="RefreshGamesButton" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource AccentButtonStyle}" Click="RefreshGamesButton_Click"/></Grid>
<TextBox x:Name="GameSearchBox" Grid.Row="1" PlaceholderText="Search games..." TextChanged="GameSearchBox_TextChanged" Margin="0,16,0,0"/>
<ScrollViewer Grid.Row="3" Margin="0,16,0,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
<ItemsRepeater x:Name="GameGrid" HorizontalAlignment="Stretch">
<ItemsRepeater.Layout><UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3" MinItemWidth="220" MinItemHeight="80" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" ItemsJustification="Start"/></ItemsRepeater.Layout>
<ItemsRepeater.ItemTemplate><DataTemplate><Grid Height="80" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Button Grid.Column="0" Tag="{Binding Game}" Click="GameCardButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="12,8"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center" HorizontalAlignment="Left"/></Button><Button Grid.Column="1" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding FavoriteGlyph}" Tag="{Binding Game}" Click="FavoriteButton_Click"/></Grid></DataTemplate></ItemsRepeater.ItemTemplate>
</ItemsRepeater>
</ScrollViewer>
</Grid>
<ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"><StackPanel Spacing="16">
<Button Content="Back" HorizontalAlignment="Left" Click="BackButton_Click"/>
<Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedGameNameText" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Profile" VerticalAlignment="Center"/><ToggleSwitch x:Name="ProfileEnabledToggle" OffContent="" OnContent="" IsEnabled="False" Toggled="ProfileEnabledToggle_Toggled"/></StackPanel></Grid>
<ctcontrols:SettingsExpander x:Name="CpuBoostExpander" Header="CPU Boost" Description="Processor performance boost mode." IsExpanded="True"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEEA1;"/></ctcontrols:SettingsExpander.HeaderIcon><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard Header="Plugged in"><ComboBox x:Name="CpuBoostAcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostAcComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard Header="On battery"><ComboBox x:Name="CpuBoostDcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostDcComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="TdpExpander" Header="TDP Control" Description="Configure processor power limits for plugged-in and battery operation." IsExpanded="True"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctcontrols:SettingsExpander.HeaderIcon><ctcontrols:SettingsExpander.Items>
<ctcontrols:SettingsCard Header="Plugged in"><StackPanel Spacing="6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel></ctcontrols:SettingsCard>
<ctcontrols:SettingsCard Header="On battery"><StackPanel Spacing="6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel></ctcontrols:SettingsCard>
</ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="DisplayExpander" Header="Display" Description="Temporary resolution while this game is active." IsExpanded="True"><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard Header="Resolution"><ComboBox x:Name="ResolutionComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="ResolutionComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander Header="Windows Power Mode" Description="Configured AC/DC Windows power mode." IsExpanded="True"><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard Header="Plugged in"><ComboBox x:Name="PowerModeAcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeAcComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard Header="On battery"><ComboBox x:Name="PowerModeDcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeDcComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="IntelFpsExpander" Header="Intel FPS Limit" Description="Uses Intel's official API. Some games may not support FPS limiting." IsExpanded="True"><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard Header="FPS Limit"><ToggleSwitch x:Name="FpsEnabledToggle" OffContent="Off" OnContent="On" Toggled="FpsEnabledToggle_Toggled"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard Header="Plugged in"><StackPanel><TextBlock x:Name="AcFpsText" Text="60 FPS"/><Slider x:Name="AcFpsSlider" Minimum="40" Maximum="120" StepFrequency="1" ValueChanged="FpsSlider_ValueChanged"/></StackPanel></ctcontrols:SettingsCard><ctcontrols:SettingsCard Header="On battery"><StackPanel><TextBlock x:Name="DcFpsText" Text="60 FPS"/><Slider x:Name="DcFpsSlider" Minimum="40" Maximum="120" StepFrequency="1" ValueChanged="FpsSlider_ValueChanged"/></StackPanel></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
</StackPanel></ScrollViewer>
</Grid></Grid></UserControl>
