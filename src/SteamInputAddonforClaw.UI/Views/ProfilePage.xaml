<UserControl x:Class="SteamInputAddonforClaw.Views.ProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
<Grid Padding="20,16" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<InfoBar x:Name="ProfileInfoBar" Grid.Row="0" IsClosable="False" IsOpen="False" Severity="Warning"/>
<Grid Grid.Row="1">
<Grid x:Name="CatalogPanel">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="24" FontWeight="SemiBold" Text="Profile"/><Button x:Name="RefreshGamesButton" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource AccentButtonStyle}" Click="RefreshGamesButton_Click"/></Grid>
<TextBox x:Name="GameSearchBox" Grid.Row="1" PlaceholderText="Search games..." TextChanged="GameSearchBox_TextChanged" Margin="0,16,0,0"/>
<GridView x:Name="GameGrid" Grid.Row="3" SizeChanged="GameGrid_SizeChanged" IsItemClickEnabled="True" ItemClick="GameGrid_ItemClick" SelectionMode="None" Margin="0,16,0,0">
<GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
<GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemHeight="80"/></ItemsPanelTemplate></GridView.ItemsPanel>
<GridView.ItemTemplate><DataTemplate><Grid Height="80" Margin="5" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center"/><Button Grid.Column="1" Width="40" Height="40" Content="{Binding FavoriteGlyph}" Tag="{Binding Game}" Click="FavoriteButton_Click"/></Grid></DataTemplate></GridView.ItemTemplate>
</GridView>
</Grid>
<ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"><StackPanel Spacing="16">
<Button Content="Back" HorizontalAlignment="Left" Click="BackButton_Click"/><TextBlock x:Name="SelectedGameNameText" FontSize="24" FontWeight="SemiBold"/>
<ctcontrols:SettingsCard><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Profile"/><ToggleSwitch Grid.Column="1" x:Name="ProfileEnabledToggle" OffContent="" OnContent="" IsEnabled="False" Toggled="ProfileEnabledToggle_Toggled"/></Grid></ctcontrols:SettingsCard>
<ctcontrols:SettingsExpander x:Name="CpuBoostExpander" Header="CPU Boost" Description="Processor performance boost mode." IsExpanded="True"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEEA1;"/></ctcontrols:SettingsExpander.HeaderIcon><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard Header="Plugged in"><ComboBox x:Name="CpuBoostAcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostAcComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard Header="On battery"><ComboBox x:Name="CpuBoostDcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostDcComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="TdpExpander" Header="TDP Control" Description="Configure processor power limits for plugged-in and battery operation." IsExpanded="True"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctcontrols:SettingsExpander.HeaderIcon><ctcontrols:SettingsExpander.Items>
<ctcontrols:SettingsCard Header="Plugged in"><StackPanel Spacing="6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel></ctcontrols:SettingsCard>
<ctcontrols:SettingsCard Header="On battery"><StackPanel Spacing="6"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel></ctcontrols:SettingsCard>
</ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
</StackPanel></ScrollViewer>
</Grid></Grid></UserControl>
