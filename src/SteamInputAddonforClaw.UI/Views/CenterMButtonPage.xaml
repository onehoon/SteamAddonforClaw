<UserControl x:Class="SteamInputAddonforClaw.Views.CenterMButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ctcontrols:SettingsExpander Header="Center M Button" Description="Configure the Center M button action used in Xbox360 presentation." IsExpanded="True">
            <ctcontrols:SettingsExpander.Items>
                <ctcontrols:SettingsCard Header="Normal Action">
                    <ComboBox x:Name="NormalSingleActionComboBox" MinWidth="220" SelectionChanged="ActionComboBox_SelectionChanged" />
                </ctcontrols:SettingsCard>
                <ctcontrols:SettingsCard x:Name="NormalSingleConfigCard" ContentAlignment="Vertical">
                    <StackPanel x:Name="NormalSingleConfigPanel" Spacing="8" />
                </ctcontrols:SettingsCard>
            </ctcontrols:SettingsExpander.Items>
    </ctcontrols:SettingsExpander>
</UserControl>
