<UserControl x:Class="SteamInputAddonforClaw.Views.XboxPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls" HorizontalContentAlignment="Stretch">
<Grid Padding="20,16" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<InfoBar x:Name="ProfileInfoBar" Grid.Row="0" IsClosable="False" IsOpen="False" Severity="Warning"/>
<Grid Grid.Row="1">
<Grid x:Name="CatalogPanel">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Xbox_CatalogTitle" FontSize="24" FontWeight="SemiBold" Text="XBOX"/><Button x:Name="RefreshGamesButton" x:Uid="Xbox_RefreshGamesButton" Grid.Column="1" Content="↻ Refresh" Style="{StaticResource AccentButtonStyle}" Click="RefreshGamesButton_Click"/></Grid>
<TextBox x:Name="GameSearchBox" x:Uid="Xbox_GameSearchBox" Grid.Row="1" PlaceholderText="Search games..." TextChanged="GameSearchBox_TextChanged" Margin="0,16,0,0"/>
<InfoBar x:Name="FavoriteStateInfoBar" x:Uid="Xbox_FavoriteStateUnavailableInfoBar" Grid.Row="2" IsClosable="False" IsOpen="False" Severity="Informational" Message="Favorite state is unavailable because profile settings could not be read."/>
<ScrollViewer Grid.Row="3" Margin="0,16,0,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
<ItemsRepeater x:Name="GameGrid" HorizontalAlignment="Stretch">
<ItemsRepeater.Layout><UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="3" MinItemWidth="220" MinItemHeight="80" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" ItemsJustification="Start"/></ItemsRepeater.Layout>
<ItemsRepeater.ItemTemplate><DataTemplate><Grid Height="80" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Button Grid.Column="0" Tag="{Binding Game}" Click="GameCardButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="12,8"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center" HorizontalAlignment="Left"/></Button><Button Grid.Column="1" Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding FavoriteGlyph}" IsEnabled="{Binding FavoriteStateKnown}" Tag="{Binding Game}" Click="FavoriteButton_Click"/></Grid></DataTemplate></ItemsRepeater.ItemTemplate>
</ItemsRepeater>
</ScrollViewer>
</Grid>
<Grid x:Name="DetailPanel" Visibility="Collapsed" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Button x:Uid="Xbox_BackButton" Grid.Row="0" Content="Back" HorizontalAlignment="Left" Click="BackButton_Click"/>
<ctcontrols:SettingsCard Grid.Row="1"><ctcontrols:SettingsCard.Header><TextBlock x:Name="SelectedGameNameText" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></ctcontrols:SettingsCard.Header></ctcontrols:SettingsCard>
<ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16">
<ctcontrols:SettingsExpander x:Name="ControllerMappingExpander" x:Uid="Xbox_ControllerMappingExpander" Header="M1 / M2 Button Mapping" Description="Enable a per-game M1 / M2 override for Xbox 360 output. Off uses the global mapping." IsExpanded="False"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8AB;"/></ctcontrols:SettingsExpander.HeaderIcon><ToggleSwitch x:Name="PerGameBackButtonMappingEnabledToggle" IsOn="False" OffContent="" OnContent="" Toggled="PerGameBackButtonMappingEnabledToggle_Toggled"/><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard x:Uid="Xbox_M1Card" Header="M1"><ComboBox x:Name="M1BackButtonTargetComboBox" MinWidth="220" SelectionChanged="BackButtonTargetComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard x:Uid="Xbox_M2Card" Header="M2"><ComboBox x:Name="M2BackButtonTargetComboBox" MinWidth="220" SelectionChanged="BackButtonTargetComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsCard x:Name="TdpCard" x:Uid="Xbox_TdpCard" Header="TDP Control" Description="Configure processor power limits for AC and DC operation." ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctcontrols:SettingsCard.HeaderIcon><StackPanel Spacing="8" HorizontalAlignment="Stretch"><ToggleSwitch x:Name="TdpEnabledToggle" Visibility="Collapsed" OffContent="" OnContent=""/><StackPanel x:Name="TdpAcCard" Spacing="6"><TextBlock x:Uid="Xbox_TdpAcRailLabel" Text="AC" FontWeight="SemiBold"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid x:Name="AcPl2Row" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="AcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="AcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="AcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel><StackPanel x:Name="TdpDcCard" Spacing="6"><TextBlock x:Uid="Xbox_TdpDcRailLabel" Text="DC" FontWeight="SemiBold"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl1Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl1Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL1" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl1Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid><Grid x:Name="DcPl2Row" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="20"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="DcPl2Value" Text="— W" VerticalAlignment="Center"/><TextBlock x:Name="DcPl2Result" Grid.Column="1" VerticalAlignment="Center"/><TextBlock Text="PL2" Grid.Column="3" VerticalAlignment="Center"/><Slider x:Name="DcPl2Slider" Grid.Column="4" ValueChanged="TdpSlider_ValueChanged"/></Grid></StackPanel></StackPanel></ctcontrols:SettingsCard>
<ctcontrols:SettingsExpander x:Name="CpuBoostExpander" x:Uid="Xbox_CpuBoostExpander" Header="CPU Boost" Description="Processor performance boost mode." IsExpanded="False"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEEA1;"/></ctcontrols:SettingsExpander.HeaderIcon><ToggleSwitch x:Name="CpuBoostEnabledToggle" Visibility="Collapsed" OffContent="" OnContent=""/><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard x:Name="CpuBoostAcCard" x:Uid="Xbox_CpuBoostAcCard" Header="AC"><ComboBox x:Name="CpuBoostAcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostAcComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard x:Name="CpuBoostDcCard" x:Uid="Xbox_CpuBoostDcCard" Header="DC"><ComboBox x:Name="CpuBoostDcComboBox" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="CpuBoostDcComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="PowerModeExpander" x:Uid="Xbox_PowerModeExpander" Header="Windows Power Mode" Description="Configured AC/DC Windows power mode." IsExpanded="False"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7E8;"/></ctcontrols:SettingsExpander.HeaderIcon><ToggleSwitch x:Name="PowerModeEnabledToggle" Visibility="Collapsed" OffContent="" OnContent=""/><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard x:Name="PowerModeAcCard" x:Uid="Xbox_PowerModeAcCard" Header="AC"><ComboBox x:Name="PowerModeAcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeAcComboBox_SelectionChanged"/></ctcontrols:SettingsCard><ctcontrols:SettingsCard x:Name="PowerModeDcCard" x:Uid="Xbox_PowerModeDcCard" Header="DC"><ComboBox x:Name="PowerModeDcComboBox" DisplayMemberPath="Label" SelectionChanged="PowerModeDcComboBox_SelectionChanged"/></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<InfoBar x:Name="GpuMinimumClockInfoBar" IsClosable="False" IsOpen="False" Visibility="Collapsed" Severity="Warning"/>
<ctcontrols:SettingsExpander x:Name="GpuMinimumClockExpander" x:Uid="Xbox_GpuMinimumClockExpander" Header="Minimum GPU Clock" Description="Overrides the Device minimum GPU clock for this game. Actual clock may still fall lower when required by power or thermal limits." IsExpanded="False"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D2;"/></ctcontrols:SettingsExpander.HeaderIcon><ToggleSwitch x:Name="GpuMinimumClockEnabledToggle" OffContent="" OnContent="" Toggled="GpuMinimumClockEnabledToggle_Toggled"/><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard x:Name="GpuMinimumClockAcCard" x:Uid="Xbox_GpuMinimumClockAcCard" Header="AC"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="GpuMinimumClockAcValueText" Text="— MHz" VerticalAlignment="Center"/><Slider x:Name="GpuMinimumClockAcSlider" Grid.Column="1" Minimum="0" Maximum="0" StepFrequency="1" ValueChanged="GpuMinimumClockSlider_ValueChanged"/></Grid></ctcontrols:SettingsCard><ctcontrols:SettingsCard x:Name="GpuMinimumClockDcCard" x:Uid="Xbox_GpuMinimumClockDcCard" Header="DC"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="GpuMinimumClockDcValueText" Text="— MHz" VerticalAlignment="Center"/><Slider x:Name="GpuMinimumClockDcSlider" Grid.Column="1" Minimum="0" Maximum="0" StepFrequency="1" ValueChanged="GpuMinimumClockSlider_ValueChanged"/></Grid></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsExpander x:Name="IntelFpsExpander" x:Uid="Xbox_IntelFpsExpander" Header="Intel FPS Limit" Description="Uses Intel's official API. Some games may not support FPS limiting." IsExpanded="False"><ctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEC4A;"/></ctcontrols:SettingsExpander.HeaderIcon><ToggleSwitch x:Name="FpsEnabledToggle" OffContent="" OnContent="" Toggled="FpsEnabledToggle_Toggled"/><ctcontrols:SettingsExpander.Items><ctcontrols:SettingsCard x:Name="FpsAcCard" x:Uid="Xbox_FpsAcCard" Header="AC"><StackPanel><TextBlock x:Name="AcFpsText" Text="60 FPS"/><Slider x:Name="AcFpsSlider" Minimum="40" Maximum="120" StepFrequency="1" ValueChanged="FpsSlider_ValueChanged"/></StackPanel></ctcontrols:SettingsCard><ctcontrols:SettingsCard x:Name="FpsDcCard" x:Uid="Xbox_FpsDcCard" Header="DC"><StackPanel><TextBlock x:Name="DcFpsText" Text="60 FPS"/><Slider x:Name="DcFpsSlider" Minimum="40" Maximum="120" StepFrequency="1" ValueChanged="FpsSlider_ValueChanged"/></StackPanel></ctcontrols:SettingsCard></ctcontrols:SettingsExpander.Items></ctcontrols:SettingsExpander>
<ctcontrols:SettingsCard x:Uid="Xbox_DisplayCard" Header="Display" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;"/></ctcontrols:SettingsCard.HeaderIcon><StackPanel Spacing="8"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Xbox_DisplayResolutionLabel" Text="Resolution" VerticalAlignment="Center"/><ComboBox x:Name="ResolutionComboBox" Grid.Column="1" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="ResolutionComboBox_SelectionChanged"/></Grid><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="Xbox_DisplayScaling100Label" Text="Display Scaling to 100%" VerticalAlignment="Center"/><ToggleSwitch x:Name="DisplayScaling100Toggle" Grid.Column="1" HorizontalAlignment="Right" OffContent="" OnContent="" Toggled="DisplayScaling100Toggle_Toggled"/></Grid></StackPanel></ctcontrols:SettingsCard>
</StackPanel></ScrollViewer>
</Grid>
</Grid></Grid></UserControl>
