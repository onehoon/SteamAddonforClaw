<UserControl
    x:Class="SteamInputAddonforClaw.Views.XboxCatalogDiagnosticPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Button Content="Back to Developer Menu" Click="BackButton_Click" HorizontalAlignment="Left" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="XBOX Catalog Diagnostic" />
            <TextBlock Opacity="0.7" Text="Read-only. No package or profile changes are performed." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanButton" Content="Scan Installed XBOX Games" Click="ScanButton_Click" />
                <Button x:Name="OpenReportButton" Content="Open Report" Click="OpenReportButton_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Ready. Choose Scan to run one package enumeration." TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            <StackPanel x:Name="GamesPanel" Spacing="8" />
            <StackPanel x:Name="FailuresPanel" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
