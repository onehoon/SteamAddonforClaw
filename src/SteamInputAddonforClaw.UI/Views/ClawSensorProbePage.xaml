<UserControl x:Class="SteamInputAddonforClaw.Views.ClawSensorProbePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="12">
    <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
    <TextBlock Text="Claw Sensor Probe" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Opacity="0.7" Text="Read-only diagnostic for MSI Claw gyroscope and accelerometer discovery and motion capture." TextWrapping="Wrap" />
    <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
    <TextBlock x:Name="DeviceText" TextWrapping="Wrap" />
    <TextBlock x:Name="ModelText" TextWrapping="Wrap" />
    <TextBlock x:Name="BoardText" TextWrapping="Wrap" />
    <TextBlock x:Name="GyroDiscoveryText" TextWrapping="Wrap" />
    <TextBlock x:Name="AccelDiscoveryText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Capture mode:" VerticalAlignment="Center" />
      <ComboBox x:Name="ModeComboBox" SelectedIndex="0" MinWidth="180">
        <ComboBoxItem Content="Live Sanity" />
        <ComboBoxItem Content="Axis Characterization" />
        <ComboBoxItem Content="Stationary Bias" />
      </ComboBox>
    </StackPanel>
    <TextBlock x:Name="PhaseText" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="InstructionText" TextWrapping="Wrap" />
    <TextBlock x:Name="LiveText" TextWrapping="Wrap" FontFamily="Consolas" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
      <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
      <Button x:Name="BackPhaseButton" Content="Previous" Click="BackPhaseButton_Click" IsEnabled="False" />
      <Button x:Name="NextPhaseButton" Content="Next" Click="NextPhaseButton_Click" IsEnabled="False" />
      <Button x:Name="DoneButton" Content="Done" Click="DoneButton_Click" IsEnabled="False" />
      <Button x:Name="OpenFolderButton" Content="Open Output Folder" Click="OpenFolderButton_Click" IsEnabled="False" />
    </StackPanel>
    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
  </StackPanel></ScrollViewer>
</UserControl>
