<UserControl
    x:Class="SteamInputAddonforClaw.Views.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Overlay" />
                <TextBlock Opacity="0.7" Text="Configure the performance overlay and display behavior." TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="ClawHudInfoBar"
                IsClosable="False"
                IsOpen="False"
                Visibility="Collapsed"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="ClawHudRetryButton" Content="Retry" Click="ClawHudRetryButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ctcontrols:SettingsCard x:Name="ClawHudEnabledCard" Header="Enable HUD">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Setting" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ctcontrols:SettingsCard.Description>
                    <TextBlock x:Name="ClawHudStatusText" TextWrapping="Wrap" />
                </ctcontrols:SettingsCard.Description>
                <ToggleSwitch x:Name="ClawHudEnabledToggleSwitch" OffContent="" OnContent="" Toggled="ClawHudEnabledToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Display mode" Description="Choose when the HUD is visible.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="View" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClawHudDisplayModeComboBox" MinWidth="220" SelectionChanged="ClawHudDisplayModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="In game only" />
                    <ComboBoxItem Content="Always" />
                </ComboBox>
            </ctcontrols:SettingsCard>
            <ctcontrols:SettingsCard Header="HUD size" Description="Adjust the overall HUD scale.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="FontSize" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClawHudSizeComboBox" MinWidth="220" SelectionChanged="ClawHudSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="-2" />
                    <ComboBoxItem Content="-1" />
                    <ComboBoxItem Content="Default" />
                    <ComboBoxItem Content="+1" />
                    <ComboBoxItem Content="+2" />
                </ComboBox>
            </ctcontrols:SettingsCard>
            <ctcontrols:SettingsCard Header="Font" Description="Font used by the performance HUD.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Font" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClawHudFontComboBox" MinWidth="220" SelectionChanged="ClawHudFontComboBox_SelectionChanged">
                    <ComboBoxItem Content="Unispace" />
                    <ComboBoxItem Content="Segoe UI Variable" />
                </ComboBox>
            </ctcontrols:SettingsCard>
            <ctcontrols:SettingsCard Header="Alignment" Description="Horizontal alignment of HUD content.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="AlignCenter" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClawHudAlignmentComboBox" MinWidth="220" SelectionChanged="ClawHudAlignmentComboBox_SelectionChanged">
                    <ComboBoxItem Content="Left" />
                    <ComboBoxItem Content="Center" />
                    <ComboBoxItem Content="Right" />
                </ComboBox>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Background width" Description="Choose how far the HUD background extends.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="FullScreen" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClawHudBackgroundComboBox" MinWidth="220" SelectionChanged="ClawHudBackgroundComboBox_SelectionChanged">
                    <ComboBoxItem Content="Full width" />
                    <ComboBoxItem Content="Content width" />
                </ComboBox>
            </ctcontrols:SettingsCard>
            <ctcontrols:SettingsCard x:Name="ClawHudOpacityCard" Header="HUD opacity">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="FontColor" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ctcontrols:SettingsCard.Description>
                    <TextBlock x:Name="ClawHudOpacityValueText" Text="—" />
                </ctcontrols:SettingsCard.Description>
                <Slider
                    x:Name="ClawHudOpacitySlider"
                    Minimum="50"
                    Maximum="100"
                    StepFrequency="5"
                    ValueChanged="ClawHudOpacitySlider_ValueChanged"
                    PointerReleased="ClawHudOpacitySlider_PointerReleased"
                    PointerCaptureLost="ClawHudOpacitySlider_PointerCaptureLost"
                    KeyUp="ClawHudOpacitySlider_KeyUp" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Intel VRR Range Fix">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ctcontrols:SettingsCard.Description>
                    <TextBlock x:Name="ClawHudVrrResultText" Opacity="0.7" TextWrapping="Wrap" />
                </ctcontrols:SettingsCard.Description>
                <ToggleSwitch
                    x:Name="ClawHudIntelVrrToggleSwitch"
                    HorizontalAlignment="Right"
                    OffContent=""
                    OnContent=""
                    Toggled="ClawHudIntelVrrToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
