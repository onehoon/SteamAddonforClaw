<UserControl x:Class="SteamInputAddonforClaw.Views.VibrationTestPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="12">
    <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
    <TextBlock Text="Vibration Test" FontSize="24" FontWeight="SemiBold" />
    <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Rumble (0xEB)" Click="Rumble_Click" />
      <Button Content="Haptic (0xEA)" Click="Haptic_Click" />
      <Button Content="Haptic Pulse (0x8F)" Click="Pulse_Click" />
      <Button Content="Stop" Click="Stop_Click" />
    </StackPanel>
    <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
  </StackPanel></ScrollViewer>
</UserControl>
