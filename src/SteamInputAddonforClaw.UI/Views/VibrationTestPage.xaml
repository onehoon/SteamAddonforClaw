<UserControl x:Class="SteamInputAddonforClaw.Views.VibrationTestPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="12">
    <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
    <TextBlock Text="Vibration Profile 0/100 Probe" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Developer-only physical hardware mutation. No SyncToROM is sent." TextWrapping="Wrap" Foreground="OrangeRed" />
    <TextBlock Text="After Apply succeeds, open Controller &gt; Vibration Strength and press Left Test once, then Right Test once if you want to retest. The 0% / 100% motor asymmetry was physically observed on A2VM 8 firmware 0x0230; this probe only reports HID transport for the current command. Return here and press Restore Addon default 50/50 when finished." TextWrapping="Wrap" Opacity="0.75" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ApplyVibrationProfileProbeButton" Content="Apply Left 0 / Right 100" Click="ApplyVibrationProfileProbe_Click" />
      <Button x:Name="RestoreVibrationProfileProbeButton" Content="Restore Addon default 50 / 50" Click="RestoreVibrationProfileProbe_Click" />
    </StackPanel>
    <TextBlock x:Name="VibrationProfileProbeStatusText" TextWrapping="Wrap" Foreground="OrangeRed" />
  </StackPanel></ScrollViewer>
</UserControl>
