<UserControl x:Class="SteamInputAddonforClaw.Views.VibrationTestPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="12">
    <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
    <TextBlock Text="Vibration Test" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Xbox360 Terminal STOP Loop" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="Replays captured Lies of P-style Xbox360 rumble bursts and stops automatically if the terminal 0/0 callback is not observed." TextWrapping="Wrap" Opacity="0.75" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    <TextBlock x:Name="RunDetailsText" TextWrapping="Wrap" FontFamily="Consolas" />
    <TextBlock x:Name="FailureText" TextWrapping="Wrap" Foreground="OrangeRed" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="StartButton" Content="Start Validation" Click="Start_Click" IsEnabled="False" />
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
    </StackPanel>
    <TextBlock Text="Vibration Profile 0/100 Probe" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
    <TextBlock Text="Developer-only physical hardware mutation. No SyncToROM is sent." TextWrapping="Wrap" Foreground="OrangeRed" />
    <TextBlock Text="After Apply succeeds, open Controller &gt; Vibration Strength and press Left Test once, then Right Test once. Return here and press Restore Addon default 50/50. A successful HID write does not prove a physical motor effect." TextWrapping="Wrap" Opacity="0.75" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ApplyVibrationProfileProbeButton" Content="Apply Left 0 / Right 100" Click="ApplyVibrationProfileProbe_Click" />
      <Button x:Name="RestoreVibrationProfileProbeButton" Content="Restore Addon default 50 / 50" Click="RestoreVibrationProfileProbe_Click" />
    </StackPanel>
    <TextBlock x:Name="VibrationProfileProbeStatusText" TextWrapping="Wrap" Foreground="OrangeRed" />
    <TextBlock Text="A2VM LED Profile Read-Only Probe" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" />
    <TextBlock Text="Reads only the 0x024A candidate profile block on A2VM firmware 0x0230. No LED profile write or SyncToROM command is issued; a parsed reply does not authorize color mutation." TextWrapping="Wrap" Foreground="OrangeRed" />
    <Button x:Name="ReadA2vmLedProfileProbeButton" Content="Read 0x024A Profile" Click="ReadA2vmLedProfileProbe_Click" HorizontalAlignment="Left" />
    <TextBlock x:Name="A2vmLedProfileProbeStatusText" TextWrapping="Wrap" />
  </StackPanel></ScrollViewer>
</UserControl>
