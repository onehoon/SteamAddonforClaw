<UserControl x:Class="SteamInputAddonforClaw.Views.VibrationTestPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="12">
    <Button Content="Back to Developer Menu" Click="Back_Click" HorizontalAlignment="Left" />
    <TextBlock Text="Vibration Test" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Xbox360 Terminal STOP Loop" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="Replays captured Lies of P-style Xbox360 rumble bursts and stops automatically if the terminal 0/0 callback is not observed." TextWrapping="Wrap" Opacity="0.75" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    <TextBlock x:Name="RunDetailsText" TextWrapping="Wrap" FontFamily="Consolas" />
    <TextBlock x:Name="FailureText" TextWrapping="Wrap" Foreground="OrangeRed" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="StartButton" Content="Start Validation" Click="Start_Click" IsEnabled="False" />
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
    </StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
