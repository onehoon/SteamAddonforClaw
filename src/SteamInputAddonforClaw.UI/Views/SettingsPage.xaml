<UserControl
    x:Class="SteamInputAddonforClaw.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="Settings_PageTitle" FontSize="24" FontWeight="SemiBold" Text="Settings" />

            <ctcontrols:SettingsCard x:Name="UpdateCard" x:Uid="Settings_UpdateCard" Header="Application updates">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Button x:Name="UpdateButton" x:Uid="Settings_UpdateButton" Content="Check" Click="UpdateButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard
                x:Name="AppThemeCard"
                x:Uid="Settings_AppThemeCard"
                Header="App theme"
                Description="Choose the main app appearance.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A1;" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="AppThemeComboBox"
                    Width="140"
                    SelectionChanged="AppThemeComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_AppTheme_System" Content="System" Tag="System" />
                    <ComboBoxItem x:Uid="Settings_AppTheme_Light" Content="Light" Tag="Light" />
                    <ComboBoxItem x:Uid="Settings_AppTheme_Dark" Content="Dark" Tag="Dark" />
                </ComboBox>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander
                x:Name="GamingHomeExpander"
                x:Uid="Settings_GamingHomeExpander"
                Description="Choose the home app used by Windows gaming full screen experience."
                Header="Windows Gaming Full Screen Experience"
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="FullScreen" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ComboBox x:Name="GamingHomeComboBox" SelectionChanged="GamingHomeComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="Settings_GamingHome_Off" Content="Off" Tag="None" />
                    <ComboBoxItem x:Uid="Settings_GamingHome_Xbox" Content="Xbox" Tag="Xbox" />
                    <ComboBoxItem x:Uid="Settings_GamingHome_SteamBigPicture" Content="Steam Big Picture" Tag="SteamBigPicture" />
                    <ComboBoxItem x:Name="GamingHomeOtherSelectionItem" x:Uid="Settings_GamingHome_Other" Content="Other Windows app" Tag="Other" />
                </ComboBox>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard
                        x:Name="GamingHomeStartupCard"
                        x:Uid="Settings_GamingHomeStartupCard"
                        Description="Start Windows directly in the selected gaming home."
                        Header="Start on Windows startup">
                        <ToggleSwitch x:Name="GamingHomeStartupToggleSwitch" OffContent="" OnContent="" Toggled="GamingHomeStartupToggleSwitch_Toggled" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard
                x:Name="QuickSettingsPowerSourceCard"
                x:Uid="Settings_QuickSettingsPowerSourceCard"
                Description="Show only the controls for the currently connected power source in Quick Settings Overlay."
                Header="Show only current power source">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="View" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="QuickSettingsPowerSourceToggleSwitch" OffContent="" OnContent="" Toggled="QuickSettingsPowerSourceToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard x:Uid="Settings_LoggingCard" Header="Logging" Description="Choose log detail.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="List" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="LogLevelComboBox"
                        Width="120"
                        SelectionChanged="LogLevelComboBox_SelectionChanged">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Info" />
                        <ComboBoxItem Content="Debug" />
                    </ComboBox>
                    <Button x:Uid="Settings_OpenLogFolderButton" Content="Open folder" Click="OpenLogFolderButton_Click" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander x:Name="RequiredComponentsExpander" x:Uid="Settings_RequiredComponentsExpander" Header="Required Components" IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsExpander.HeaderIcon>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard
                x:Name="DeveloperMenuCard"
                Click="DeveloperMenuButton_Click"
                Description="Developer-only diagnostics. General users should not use this menu."
                Header="Developer Menu"
                IsClickEnabled="True">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Help" />
                </ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
