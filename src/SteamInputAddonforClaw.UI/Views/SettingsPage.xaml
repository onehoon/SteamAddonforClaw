<UserControl
    x:Class="SteamInputAddonforClaw.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Settings" />

            <ctcontrols:SettingsCard x:Name="UpdateCard" Header="Application updates">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Rotate" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <Button x:Name="UpdateButton" Content="Check" Click="UpdateButton_Click" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander
                x:Name="GamingHomeExpander"
                Description="Choose the home app used by Windows gaming full screen experience."
                Header="Windows Gaming Full Screen Experience"
                IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="FullScreen" />
                </ctcontrols:SettingsExpander.HeaderIcon>
                <ComboBox x:Name="GamingHomeComboBox" SelectionChanged="GamingHomeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Off" Tag="None" />
                    <ComboBoxItem Content="Xbox" Tag="Xbox" />
                    <ComboBoxItem Content="Steam Big Picture" Tag="SteamBigPicture" />
                    <ComboBoxItem x:Name="GamingHomeOtherSelectionItem" Content="Other Windows app" Tag="Other" />
                </ComboBox>
                <ctcontrols:SettingsExpander.Items>
                    <ctcontrols:SettingsCard
                        x:Name="GamingHomeStartupCard"
                        Description="Start Windows directly in the selected gaming home."
                        Header="Start on Windows startup">
                        <ToggleSwitch x:Name="GamingHomeStartupToggleSwitch" OffContent="" OnContent="" Toggled="GamingHomeStartupToggleSwitch_Toggled" />
                    </ctcontrols:SettingsCard>
                </ctcontrols:SettingsExpander.Items>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard
                x:Name="QuickSettingsPowerSourceCard"
                Description="Show only the controls for the currently connected power source in Quick Settings Overlay."
                Header="Show only current power source">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="View" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="QuickSettingsPowerSourceToggleSwitch" OffContent="" OnContent="" Toggled="QuickSettingsPowerSourceToggleSwitch_Toggled" />
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsCard Header="Logging" Description="Choose log detail.">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="List" />
                </ctcontrols:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="LogLevelComboBox"
                        Width="120"
                        SelectionChanged="LogLevelComboBox_SelectionChanged">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Info" />
                        <ComboBoxItem Content="Debug" />
                    </ComboBox>
                    <Button Content="Open folder" Click="OpenLogFolderButton_Click" />
                </StackPanel>
            </ctcontrols:SettingsCard>

            <ctcontrols:SettingsExpander x:Name="RequiredComponentsExpander" Header="Required Components" IsExpanded="False">
                <ctcontrols:SettingsExpander.HeaderIcon>
                    <SymbolIcon Symbol="Repair" />
                </ctcontrols:SettingsExpander.HeaderIcon>
            </ctcontrols:SettingsExpander>

            <ctcontrols:SettingsCard
                x:Name="DeveloperMenuCard"
                Click="DeveloperMenuButton_Click"
                Description="Developer-only diagnostics. General users should not use this menu."
                Header="Developer Menu"
                IsClickEnabled="True">
                <ctcontrols:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Help" />
                </ctcontrols:SettingsCard.HeaderIcon>
            </ctcontrols:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
