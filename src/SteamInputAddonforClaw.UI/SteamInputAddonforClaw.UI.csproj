<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SteamInputAddonforClaw.UI</AssemblyName>
    <RootNamespace>SteamInputAddonforClaw.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamInputAddonforClaw.Contracts\SteamInputAddonforClaw.Contracts.csproj" />
    <ProjectReference Include="..\SteamInputAddonforClaw.FrontendTransport\SteamInputAddonforClaw.FrontendTransport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Unpackaged WinUI publish can omit generated XBF files and the application PRI
    produced in the build output. The external UI project owns these XAML assets,
    so preserve them in the UI publish payload.
  -->
  <Target Name="CopyMissingWinUIPublishAssets" AfterTargets="Publish">
    <ItemGroup>
      <_MissingXbf Include="$(OutDir)**\*.xbf" />
      <_MissingApplicationPri Include="$(OutDir)$(AssemblyName).pri" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
      <_MissingAssets Include="$(OutDir)Assets\**\*.*" />
    </ItemGroup>
    <Message Importance="High" Text="Preserving external UI WinUI publish assets: XBF=@(_MissingXbf); Application PRI=@(_MissingApplicationPri); Assets=@(_MissingAssets)" />
    <Copy SourceFiles="@(_MissingXbf)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_MissingXbf)' != ''" />
    <Copy SourceFiles="@(_MissingApplicationPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_MissingApplicationPri)' != ''" />
    <Copy SourceFiles="@(_MissingAssets)" DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_MissingAssets)' != ''" />
  </Target>
</Project>
