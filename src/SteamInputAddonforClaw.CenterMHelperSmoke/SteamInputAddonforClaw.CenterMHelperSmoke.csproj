<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not part of the shipped product. A CI-only smoke tool that exercises the real
         CenterMHelperStaging/CenterMHelperOwnership production classes (via InternalsVisibleTo on
         the main project) to prove the final staged/renamed helper artifact actually starts and
         can be stopped through retained ownership. Run as a plain console executable rather than
         through dotnet test/VSTest, whose own process-tree management was found to interfere with
         this specific CreateProcess(SUSPENDED) + Job sequence. See
         scripts/verify-centerm-helper-smoke.ps1. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SteamInputAddonforClaw.CenterMHelperSmoke</AssemblyName>
    <RootNamespace>SteamInputAddonforClaw.CenterMHelperSmoke</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamInputAddonforClaw\SteamInputAddonforClaw.csproj" />
  </ItemGroup>
</Project>
